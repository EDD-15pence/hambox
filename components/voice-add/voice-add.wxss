/* 首页悬浮语音入口 + 确认面板 */

/* ============ 悬浮按钮 ============ */
.va-fab {
  position: fixed;
  right: var(--sp-4);
  bottom: calc(var(--sp-6) + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  color: var(--on-primary);
  background: var(--primary-strong);
  box-shadow: var(--shadow-fab);
}

.va-fab--active {
  opacity: 0.86;
}

/*
 * 麦克风：话筒头 / U 形托架 / 竖杆三段，全部靠 flex 的 align-items:center 居中。
 *
 * 三条约束，改尺寸时必须同时满足：
 * 1. 不要改回 left:50% + 负 margin-left 的绝对定位，居中交给 flex；
 * 2. 托架必须 border-box，否则 4rpx 边框会让实际宽度比声明宽 8rpx、整体右偏；
 * 3. 所有尺寸取 4rpx 的整数倍。375 屏 1rpx=0.5px，只有 4rpx 的倍数才能保证
 *    居中后每条边都落在整像素上；否则左右各落在半像素上，抗锯齿覆盖不同，
 *    4rpx 的细边框会一边显粗一边显细，看着就是歪的（实测镜像差异 2.77% → 0.12%）。
 */
.va-mic-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 64rpx;
  height: 64rpx;
  color: inherit;
}

.va-mic-icon--lg {
  transform: scale(1.45);
}

.va-mic-icon__cap {
  flex: none;
  margin-top: 4rpx;
  width: 20rpx;
  height: 28rpx;
  border-radius: 10rpx;
  background: currentColor;
}

.va-mic-icon__arc {
  box-sizing: border-box;
  flex: none;
  /* 上提，让两臂抱住话筒头两侧；底部要明显低于话筒头，否则两段会糊成一块 */
  margin-top: -20rpx;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
}

.va-mic-icon__stem {
  flex: none;
  width: 4rpx;
  height: 12rpx;
  border-radius: 0 0 2rpx 2rpx;
  background: currentColor;
}

/* ============ 面板 ============ */
.va-sheet {
  padding-bottom: calc(var(--sp-3) + env(safe-area-inset-bottom));
}

/* ============ 收音阶段 ============ */
.va-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-4) 0 var(--sp-3);
}

.va-pulse-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--sp-3);
}

/* 录音时向外扩散的圈：放在按钮下面，只露出边缘 */
.va-pulse {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  background: var(--primary-strong);
  opacity: 0.24;
  animation: va-pulse 1.8s ease-out infinite;
}

@keyframes va-pulse {
  0% {
    transform: scale(1);
    opacity: 0.24;
  }
  100% {
    transform: scale(1.42);
    opacity: 0;
  }
}

.va-rec__btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  color: var(--on-primary);
  background: var(--primary-strong);
  box-shadow: var(--shadow-fab);
}

/* 彩色底不叠 inset，用亮度变化表示按下 */
.va-rec__btn.is-rec {
  background: var(--primary);
  box-shadow: none;
}

.va-wave {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 84rpx;
}

.va-wave__bar {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--on-primary);
  animation: va-wave 0.9s ease-in-out infinite;
}

@keyframes va-wave {
  0%,
  100% {
    height: 20rpx;
  }
  50% {
    height: 64rpx;
  }
}

.va-hint {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-1);
}

.va-hint--sub {
  margin-top: var(--sp-1);
  font-size: var(--fs-tiny);
  font-weight: 400;
  color: var(--text-3);
}

.va-live {
  box-sizing: border-box;
  width: 100%;
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.va-live__text {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  font-size: var(--fs-caption);
  line-height: 1.6;
  color: var(--text-2);
}

/* ============ 确认阶段 ============ */
.va-scroll {
  box-sizing: border-box;
  height: 44vh;
  padding: var(--sp-1) 0;
}

.va-raw {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  margin-bottom: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.va-raw__text {
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-size: var(--fs-caption);
  line-height: 1.6;
  color: var(--text-2);
}

.va-raw__again {
  flex: none;
  font-size: var(--fs-tiny);
  color: var(--primary-strong);
}

.va-field {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-1) 0;
}

.va-field__label {
  flex: none;
  width: 112rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.va-field__body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.va-qty {
  width: 140rpx;
  flex: none;
  text-align: center;
}

.va-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-1);
}

.va-missing {
  margin: 0 0 var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--warning-weak);
}

.va-missing__text {
  font-size: var(--fs-tiny);
  line-height: 1.5;
  color: var(--warning);
}

/* ============ 底部操作 ============ */
.va-footer {
  display: flex;
  gap: var(--sp-2);
  padding-top: var(--sp-3);
}

.va-footer .ui-btn {
  flex: 1;
}
