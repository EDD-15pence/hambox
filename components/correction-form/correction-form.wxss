/* 新建 / 编辑矫正项的表单（H-06）。只用 v2 令牌，深色自动跟随 */

.cf-sheet {
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.cf-body {
  max-height: 62vh;
  padding-bottom: var(--sp-2);
}

/* 预设：两行三个，选中的带主色描边 */
.cf-presets {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  padding: var(--sp-1) 0 var(--sp-2);
}

.cf-preset {
  width: calc((100% - var(--sp-2) * 2) / 3);
  box-sizing: border-box;
  padding: var(--sp-3) var(--sp-2);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border: 2rpx solid transparent;
}

.cf-preset.is-on {
  border-color: var(--primary);
  background: var(--primary-weak);
}

.cf-preset__icon {
  font-size: 40rpx;
  line-height: 1;
}

.cf-preset__name {
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.cf-preset.is-on .cf-preset__name {
  color: var(--primary-text);
}

.cf-label {
  display: block;
  margin: var(--sp-3) 0 var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.cf-icons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
}

.cf-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 34rpx;
  border-radius: var(--r-sm);
  background: var(--bg-sunken);
  border: 2rpx solid transparent;
}

.cf-icon.is-on {
  border-color: var(--primary);
  background: var(--primary-weak);
}

.cf-modes,
.cf-days {
  display: flex;
  gap: var(--sp-2);
}

.cf-days {
  margin-top: var(--sp-2);
}

.cf-chip {
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.cf-chip.is-on {
  color: var(--on-primary);
  background: var(--primary);
  box-shadow: var(--shadow-raised);
}

.cf-day {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: var(--r-sm);
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: var(--bg-sunken);
}

.cf-day.is-on {
  color: var(--on-primary);
  background: var(--primary);
}

.cf-times {
  display: flex;
  gap: var(--sp-3);
}

.cf-time {
  flex: 1;
}

.cf-time__value {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  font-size: var(--fs-body);
  color: var(--text-1);
}

.cf-stepper {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.cf-step {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--r-sm);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-raised);
  font-size: var(--fs-h2);
  color: var(--text-1);
}

.cf-step:active {
  box-shadow: var(--shadow-raised-press);
}

.cf-step__value {
  min-width: 72rpx;
  text-align: center;
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text-1);
}

.cf-error {
  display: block;
  margin-top: var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--danger);
}

.cf-save {
  margin-top: var(--sp-3);
  flex: none;
}
