<view class="flight-root">
<view class="app-nav" style="padding-top:{{statusBarHeight}}px">
  <view class="nav-left">
    <text class="nav-back-icon" bindtap="onBack">‹</text>
    <text class="app-nav__title">机票比价</text>
  </view>
  <text class="ui-badge">原型</text>
</view>
<view class="page">
  <view class="hero"><text class="hero-icon">✈️</text><view><text class="hero-title">机票比价</text><text class="hero-subtitle">查询携程、去哪儿、同程、飞猪</text></view></view>
  <view class="search-card">
    <view class="field-row"><view class="field"><text class="field-label">出发地</text><input placeholder="出发城市" value="{{departure}}" bindinput="onDepartureInput" maxlength="20" /></view><text class="arrow">→</text><view class="field"><text class="field-label">目的地</text><input placeholder="到达城市" value="{{destination}}" bindinput="onDestinationInput" maxlength="20" /></view></view>
    <view class="date-field"><text>出发日期</text><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="onDateChange"><view class="date-value">{{date}} <text class="chevron">›</text></view></picker></view>
    <button class="search-button" bindtap="onSearch">开始比价</button>
  </view>
  <view wx:if="{{searched}}" class="results">
    <view class="result-heading"><view><text class="route">{{routeText}}</text><text class="travel-date">{{date}} 出发</text></view><text class="result-count">4 个平台</text></view>
    <view class="notice"><text class="notice-icon">i</text><text>暂未接入平台授权接口；可复制行程后手动在对应平台搜索。</text></view>
    <view class="platform-list"><view wx:for="{{platforms}}" wx:key="name" class="platform-card"><view class="platform-logo" style="background-color: {{item.color}}">{{item.icon}}</view><view class="platform-info"><text class="platform-name">{{item.name}}</text><text class="platform-status">{{item.status}}</text></view><button class="copy-button" bindtap="onCopySearch" data-platform="{{item.shortName}}">复制行程</button></view></view>
  </view>
  <view wx:else class="empty-state"><text class="empty-icon">🛫</text><text class="empty-title">输入行程，开始比价</text><text class="empty-desc">支持国内和国际航线查询</text></view>
</view>
  <feedback-fab />
</view>
