/* A-07 令牌迁移：本页原先是独立的白底 + 纯黑字风格，另带一整块手写夜间覆盖。
   现全部收口到 styles/tokens.wxss —— 深色只需 .container.dark 上的变量覆盖，
   原来那段 .container.dark 块已删除（否则两套深色互相打架）。 */

.container {
  min-height: 100vh;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}
.top {
  padding: 20rpx;
  background: var(--bg-raised);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-raised);
}
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.gender {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.label {
  color: var(--text-1);
  font-weight: 600;
}
.gender-group {
  display: flex;
  gap: 24rpx;
  color: var(--text-1);
}
.gender-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.top-actions {
  display: flex;
  gap: 8rpx;
}
.icon-btn {
  background: transparent;
  border: none;
  padding: 8rpx 12rpx;
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-1);
}
.icon-hover {
  opacity: 0.6;
}

.audio-buttons {
  display: flex;
  gap: 16rpx;
  margin-left: 20rpx;
}

.audio-btn {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 12rpx;
  opacity: 0.8;
  transition: opacity 0.2s ease;
}

.audio-btn:active {
  opacity: 0.6;
}

.audio-disabled {
  opacity: 0.3 !important;
  pointer-events: none;
}
.formula-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
}
.formula {
  color: var(--text-1);
  min-height: 44rpx;
}
.result-large {
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-2);
  min-height: 64rpx;
}
.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.spacer {
  flex: 1;
}
.keypad {
  padding-top: 20rpx;
}
.row {
  display: flex;
  margin-bottom: 0;
}
.key {
  flex: 1;
  background: var(--bg-sunken);
  border: none;
  border-radius: 0;
  color: var(--text-1);
  padding: 26rpx 0;
}
.key::after {
  border: none;
}
.key[disabled] {
  opacity: 0.45;
  color: var(--text-3) !important;
}
/* 按下态：原来是把底色换成浅灰，深色下会闪成一块亮斑，改用凹陷阴影表达 */
.btn-press {
  box-shadow: var(--shadow-sunken-sm) !important;
}
.key.back {
  color: var(--success);
}
.key.clear {
  color: var(--danger);
}
