/* A-07 令牌迁移：本页原先是独立的白卡 + 蓝色系（96 处硬编码色），
   并在文件末尾手写了一整块 .dark 覆盖（深灰底 + 各种灰色文字）。
   现已全部收口到 styles/tokens.wxss —— 深色只靠 .container.dark 的变量覆盖，
   末尾那段 .dark 块已删除（否则两套深色互相打架）。
   尺寸单位沿用原值（px）未动，只换色与层级表达。 */

.container {
  padding: 20px;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial;
  background-color: var(--bg-page);
  color: var(--text-1);
}

/* 导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.navbar-actions {
  display: flex;
  gap: 8px;
}

.title {
  font-size: 24px;
  font-weight: 600;
  color: var(--text-1);
}

.icon-btn {
  background: transparent;
  border: none;
  font-size: 20px;
  padding: 4px 8px;
  line-height: 1;
  color: var(--text-1);
}

/* 时间卡片 */
.time-card {
  background: var(--bg-raised);
  padding: 16px;
  border-radius: 12px;
  box-shadow: var(--shadow-raised);
  margin-bottom: 16px;
  text-align: center;
}

.time-label {
  color: var(--text-3);
  font-size: 12px;
  display: block;
  margin-bottom: 8px;
}

.now-time {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-1);
  display: block;
}

/* 习惯列表 */
.habits-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* 习惯卡片 */
.habit-card {
  background: var(--bg-raised);
  border-radius: 12px;
  padding: 16px;
  box-shadow: var(--shadow-raised);
  border-left: 4px solid var(--primary);
}

.habit-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.habit-info {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}

.habit-icon {
  font-size: 32px;
  line-height: 1;
}

.habit-name-wrapper {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.habit-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-1);
}

.habit-difficulty {
  font-size: 12px;
  padding: 0px 5px 12px 5px;
  border-radius: 10px;
  display: inline-block;
  width: fit-content;
}

.difficulty-easy {
  background: var(--success-weak);
  color: var(--success);
}

.difficulty-medium {
  background: var(--warning-weak);
  color: var(--warning);
}

.difficulty-hard {
  background: var(--danger-weak);
  color: var(--danger);
}

.habit-actions {
  display: flex;
  gap: 4px;
}

.action-btn {
  background: transparent;
  border: none;
  font-size: 16px;
  padding: 4px;
  opacity: 0.6;
}

.action-btn:active {
  opacity: 1;
}

/* 统计信息 */
.habit-stats {
  display: flex;
  justify-content: space-around;
  padding: 12px 0;
  border-top: 1px solid var(--divider);
  border-bottom: 1px solid var(--divider);
  margin-bottom: 12px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex: 1;
}

.stat-label {
  font-size: 11px;
  color: var(--text-3);
}

.stat-value {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-1);
}

.stat-value.highlight {
  color: var(--primary-text);
}

/* 进度条 */
.progress-wrapper {
  margin-bottom: 12px;
}

.progress-bar {
  height: 6px;
  background: var(--bg-sunken);
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 3px;
  transition: width 0.3s ease;
}

/* 打卡区域 */
.checkin-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.checkin-btn {
  flex: 1;
  background: var(--primary-strong);
  color: var(--on-primary);
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  font-weight: 500;
  transition: all 0.2s;
}

/* 已打卡：原来是一块亮绿实心 + 白字，其实只有 1.9:1（深色下更糟）。
   改成弱绿底 + 强绿字 + 内描边，两种模式下都读得清，也没有新增令牌。 */
.checkin-btn.checked {
  background: var(--success-weak);
  color: var(--success);
  box-shadow: inset 0 0 0 2rpx var(--success);
}

.checkin-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.reminder-text {
  font-size: 12px;
  color: var(--text-3);
  white-space: nowrap;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  background: var(--bg-raised);
  border-radius: 12px;
  box-shadow: var(--shadow-raised);
}

.empty-icon {
  font-size: 64px;
  display: block;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
  color: var(--text-1);
  display: block;
  margin-bottom: 8px;
  font-weight: 500;
}

.empty-hint {
  font-size: 14px;
  color: var(--text-3);
  display: block;
  margin-bottom: 24px;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  background: var(--bg-raised);
  border-radius: 20px 20px 0 0;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--divider);
  position: sticky;
  top: 0;
  background: var(--bg-raised);
  z-index: 10;
}

.modal-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-1);
}

.modal-close {
  background: transparent;
  border: none;
  font-size: 24px;
  color: var(--text-3);
  padding: 0;
  width: 32px;
  height: 32px;
  line-height: 32px;
}

.modal-body {
  padding: 20px;
}

.form-item {
  margin-bottom: 24px;
}

.form-label {
  font-size: 14px;
  color: var(--text-2);
  font-weight: 500;
  display: block;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  height: 40px;
  padding: 12px;
  border: 1px solid var(--divider);
  border-radius: 8px;
  font-size: 16px;
  color: var(--text-1);
  background: var(--bg-raised);
  box-sizing: border-box;
}

/* 图标选择器 */
.icon-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.icon-option {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--divider);
  border-radius: 8px;
  font-size: 24px;
  background: var(--bg-raised);
  transition: all 0.2s;
}

.icon-option.selected {
  border-color: var(--primary);
  background: var(--primary-weak);
}

.icon-option:active {
  transform: scale(0.95);
}

/* 颜色选择器 */
.color-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.color-option {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid transparent;
  transition: all 0.2s;
}

.color-option.selected {
  border-color: var(--text-1);
  transform: scale(1.1);
}

.check-mark {
  color: var(--on-primary);
  font-size: 18px;
  font-weight: bold;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

/* 难度选择器 */
.difficulty-selector {
  display: flex;
  gap: 12px;
}

.difficulty-option {
  flex: 1;
  padding: 12px;
  border: 2px solid var(--divider);
  border-radius: 8px;
  text-align: center;
  background: var(--bg-raised);
  transition: all 0.2s;
}

.difficulty-option.selected {
  border-color: var(--primary);
  background: var(--primary-weak);
}

.difficulty-label {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-2);
  display: block;
  margin-bottom: 4px;
}

.difficulty-desc {
  font-size: 11px;
  color: var(--text-3);
  display: block;
}

/* 时间选择器 */
.picker-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px;
  border: 1px solid var(--divider);
  border-radius: 8px;
  background: var(--bg-raised);
}

.picker-text {
  font-size: 16px;
  color: var(--text-1);
}

.picker-arrow {
  font-size: 20px;
  color: var(--text-3);
}

.modal-footer {
  display: flex;
  gap: 12px;
  padding: 20px;
  border-top: 1px solid var(--divider);
  position: sticky;
  bottom: 0;
  background: var(--bg-raised);
}

.btn-cancel,
.btn-save {
  flex: 1;
  padding: 12px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  border: none;
}

.btn-cancel {
  background: var(--bg-sunken);
  color: var(--text-2);
}

.btn-save {
  background: var(--primary-strong);
  color: var(--on-primary);
}

.btn-primary {
  background: var(--primary-strong);
  color: var(--on-primary);
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  font-weight: 500;
}
