<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">版本答案</text>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onOpenCreate">＋ 记一条</text>
    </view>
  </view>

  <view class="search">
    <input
      class="ui-input search__input"
      value="{{query}}"
      placeholder="搜「奶茶」「火锅」…"
      placeholder-class="ui-placeholder"
      confirm-type="search"
      bindinput="onQueryInput" />
    <text wx:if="{{query}}" class="search__clear" bindtap="onClearQuery">清空</text>
  </view>

  <view class="page-body">
    <view wx:if="{{error}}" class="ui-empty">
      <text class="ui-empty__title">没拉到答案</text>
      <text class="ui-empty__hint">{{error}}</text>
      <button class="ui-btn is-block ans-retry" bindtap="onRetry">重试</button>
    </view>

    <block wx:if="{{!error}}">
      <view wx:if="{{!loading && !items.length}}" class="ui-empty">
        <text class="ui-empty__title">{{query ? '没有匹配的答案' : '还没有答案'}}</text>
        <text class="ui-empty__hint">{{query ? '换个词，或者直接把它记成一条' : '比如「奶茶 → 沪上阿姨 啵啵奶茶 五分糖」'}}</text>
        <button wx:if="{{query}}" class="ui-btn is-block ans-retry" bindtap="onOpenCreate">把「{{query}}」记下来</button>
      </view>

      <view
        wx:for="{{items}}"
        wx:key="id"
        class="ui-card ans"
        data-answer="{{item.answer}}"
        data-id="{{item.id}}"
        bindtap="onCopyAnswer"
        bindlongpress="onEditAnswer">
        <view class="ans__head">
          <text class="ans__keyword">{{item.keyword}}</text>
          <text wx:if="{{item.verdict}}" class="ans__tag {{item.verdict === '踩雷' ? 'is-bad' : 'is-good'}}">{{item.verdict}}</text>
          <text wx:if="{{item.who}}" class="ans__who">{{item.who}}</text>
        </view>
        <text class="ans__answer">{{item.answer}}</text>
        <text class="ans__hint">点一下复制 · 长按可改</text>
      </view>
    </block>
  </view>

  <!-- 录入 / 编辑面板 -->
  <view wx:if="{{form}}" class="ui-mask" bindtap="onCloseForm">
    <view class="ui-sheet ans-sheet" catchtap="onNoop">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">{{form.id ? '改这条答案' : '记一条答案'}}</text>
        <text class="nav-text-btn" bindtap="onCloseForm">关闭</text>
      </view>

      <text class="ans-sheet__label">关键词</text>
      <input
        class="ui-input"
        value="{{form.keyword}}"
        placeholder="奶茶"
        placeholder-class="ui-placeholder"
        data-field="keyword"
        maxlength="128"
        bindinput="onFormField" />

      <text class="ans-sheet__label">答案（整句，复制出去就能用）</text>
      <textarea
        class="ui-input ans-sheet__area"
        value="{{form.answer}}"
        placeholder="沪上阿姨 啵啵奶茶 五分糖"
        placeholder-class="ui-placeholder"
        data-field="answer"
        maxlength="1000"
        cursor-spacing="24"
        bindinput="onFormField" />

      <text class="ans-sheet__label">结论</text>
      <view class="chips">
        <text
          wx:for="{{verdicts}}"
          wx:key="*this"
          class="chip {{form.verdict === item ? 'is-on' : ''}}"
          data-value="{{item}}"
          bindtap="onPickVerdict">{{item || '不标'}}</text>
      </view>

      <text class="ans-sheet__label">谁的口味</text>
      <view class="chips">
        <text
          wx:for="{{whos}}"
          wx:key="*this"
          class="chip {{form.who === item ? 'is-on' : ''}}"
          data-value="{{item}}"
          bindtap="onPickWho">{{item || '共用'}}</text>
      </view>

      <view wx:if="{{form.id}}" class="ans-sheet__foot">
        <button class="ui-btn ans-sheet__del" bindtap="onDeleteAnswer">删掉</button>
        <button
          class="ui-btn is-primary ans-sheet__ok"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="onSaveForm">保存</button>
      </view>
      <button
        wx:else
        class="ui-btn is-primary is-block ans-sheet__save"
        loading="{{saving}}"
        disabled="{{saving}}"
        bindtap="onSaveForm">存下来</button>
    </view>
  </view>

  <feedback-fab />
</view>
