/* ============================================================
 * 店铺记 · 仓库墙（§17 / SH-02）
 *
 * 材质语言沿用全站 v2：页面同色底 + 影子说明层次。
 * 这一页唯一的特殊点是「格子」用**凹槽**（inset）而不是凸起 ——
 * 货架上的格子本来就是槽，而且凹槽没有外侧白高光，
 * 三列挤在一起时不会互相污染（见 AGENTS.md §10-22 的 A-12）。
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

.app-nav {
  position: sticky;
  top: 0;
  z-index: 20;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------------- 今日日报 ---------------- */

.today {
  display: flex;
  margin: var(--sp-2) var(--page-x) 0;
  padding: var(--sp-3) var(--sp-2);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.today__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

/* 三栏之间的分隔线用伪元素，避免多包一层 view */
.today__item + .today__item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: var(--divider);
}

.today__label {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.today__value {
  font-size: var(--fs-h1);
  font-weight: 700;
  line-height: 1.1;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.today__value.is-gain {
  color: var(--success);
}

.today__value.is-loss {
  color: var(--danger);
}

.today__unit {
  font-size: var(--fs-tiny);
  font-weight: 400;
  color: var(--text-3);
}

.today__sub {
  font-size: var(--fs-tiny);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* ---------------- 品类 tab ---------------- */

.tabs {
  position: sticky;
  top: var(--nav-h);
  z-index: 19;
  width: 100%;
  margin-top: var(--sp-2);
  background: var(--bg-page);
  white-space: nowrap;
}

.tabs__inner {
  display: inline-flex;
  gap: var(--sp-1);
  padding: var(--sp-1) var(--page-x) var(--sp-2);
}

.tab {
  flex: none;
  padding: 10rpx var(--sp-3);
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  transition: background var(--dur-fast) ease-out;
}

.tab.is-on {
  color: var(--on-primary);
  background: var(--primary);
  box-shadow: none;
}

/* ---------------- 品牌分区 ---------------- */

.brand {
  margin-bottom: var(--sp-3);
}

.brand__head {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-1) 0;
}

/* 品牌图标槽：底下一层首字色块，logo 加载成功才盖上去（见 wxml 注释） */
.brand__logo {
  position: relative;
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
}

.brand__logo-text {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-caption);
  font-weight: 700;
  /* 品牌色块上压字用 --on-primary（两档都是白），不要用 --text-invert：
     深色下它是深灰，压在饱和蓝上反而更糊 */
  color: var(--on-primary);
  line-height: 1;
}

.brand__logo-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.brand__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.brand__count {
  flex: none;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* ---------------- 格子墙 ---------------- */

.cells {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-1);
}

.cell {
  display: flex;
  flex-direction: column;
  padding: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.cell__model {
  font-size: var(--fs-caption);
  line-height: 1.3;
  color: var(--text-1);
  /* 机型名普遍偏长（iPhone 15 Pro），允许两行，再长就省略 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.cell__stock {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 6rpx;
}

.cell__label {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.cell__num {
  font-size: var(--fs-h2);
  font-weight: 700;
  line-height: 1;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.cell__num.is-out {
  color: var(--text-3);
}

.cell__ops {
  display: flex;
  gap: 6rpx;
  margin-top: var(--sp-1);
}

/* 两个小按钮：命中区域按 44rpx 做（远小于 88 最小点按尺寸，但格子里挤不下，
   靠 8rpx 的间隙与「点击即落库」的低风险互抵，误触只需再点一次反向操作） */
.cell__btn {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 700;
  border-radius: var(--r-sm);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.cell__btn:active {
  box-shadow: var(--shadow-raised-press);
}

.cell__btn--in {
  color: var(--primary-text);
  background: var(--primary-weak);
}

.cell__btn--out {
  color: var(--text-1);
}

.cell__btn.is-off {
  color: var(--text-3);
  opacity: 0.55;
  box-shadow: none;
}

.hint {
  display: block;
  margin: var(--sp-2) 0 var(--sp-3);
  font-size: var(--fs-tiny);
  line-height: 1.5;
  color: var(--text-3);
}

.retry {
  margin-top: var(--sp-3);
}

/* ---------------- 底部 ---------------- */

.bottom {
  padding: var(--sp-2) var(--page-x) calc(var(--sp-4) + env(safe-area-inset-bottom));
}

.bottom__add {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
}

/* ---------------- 弹层补充 ---------------- */

.sheet__sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.sheet__label {
  display: block;
  margin: var(--sp-2) 0 6rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.sheet__save {
  margin-top: var(--sp-3);
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
}

.sheet__foot {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.sheet__del {
  flex: 0 0 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
  color: var(--danger);
  background: var(--danger-weak);
}

.sheet__ok {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
}

.chips--scroll {
  width: 100%;
  white-space: nowrap;
}

.chips__inner {
  display: inline-flex;
  gap: var(--sp-1);
}

.chip {
  flex: none;
  padding: 10rpx var(--sp-3);
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
  color: var(--text-2);
  background: var(--bg-sunken);
}

.chip.is-on {
  color: var(--on-primary);
  background: var(--primary);
}

.chip.is-ghost {
  color: var(--primary-text);
  background: var(--primary-weak);
}
