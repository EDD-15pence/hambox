<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">物品详情</text>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onEdit">编辑</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body">
    <!-- 加载中 -->
    <block wx:if="{{loading && !item.id}}">
      <view class="detail-skeleton">
        <view class="detail-skeleton__hero ui-skeleton"></view>
        <view class="detail-skeleton__line ui-skeleton"></view>
        <view class="detail-skeleton__block ui-skeleton"></view>
        <view class="detail-skeleton__row ui-skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>
    </block>

    <!-- 连不上后端 -->
    <conn-error
      wx:elif="{{loadError && !item.id}}"
      message="{{loadError}}"
      base-url="{{baseUrl}}"
      retrying="{{retrying}}"
      bind:retry="onRetry" />

    <block wx:else>
    <!-- 主视觉：有照片放照片，没有就放分类图标 -->
    <view class="hero">
      <image wx:if="{{item.imageSrc}}" class="hero__image" src="{{item.imageSrc}}" mode="aspectFill" bindtap="onPreviewImage" />
      <text wx:else class="hero__emoji">{{categoryIcon}}</text>
    </view>

    <!-- 名称 + 状态 -->
    <view class="headline">
      <text class="headline__name">{{item.name}}</text>
      <text wx:if="{{item.status}}" class="ui-badge is-{{item.status === 'expired' ? 'expired' : (item.status === 'warning' ? 'warning' : 'fresh')}}">{{statusText}}</text>
    </view>

    <!-- 倒计时：整页唯一的视觉焦点，放在凹槽里 -->
    <view class="countdown">
      <block wx:if="{{hasDays}}">
        <text class="countdown__prefix">{{daysPrefix}}</text>
        <text class="countdown__num is-{{item.status}} num">{{daysNum}}</text>
        <text class="countdown__unit">天</text>
      </block>
      <text wx:else class="countdown__none">未设置保质期</text>
    </view>

    <text class="ui-section-title">基本信息</text>
    <view class="rows">
      <view class="ui-row">
        <text class="ui-row__label">分类</text>
        <text class="ui-row__value">{{categoryIcon}} {{categoryName}}</text>
      </view>
      <view class="ui-row">
        <text class="ui-row__label">数量</text>
        <text class="ui-row__value num">{{item.quantity}} {{item.unit}}</text>
      </view>
      <view class="ui-row">
        <text class="ui-row__label">存放位置</text>
        <text class="ui-row__value">{{item.location || '未设置'}}</text>
      </view>
    </view>

    <text class="ui-section-title">日期</text>
    <view class="rows">
      <view class="ui-row">
        <text class="ui-row__label">生产日期</text>
        <text class="ui-row__value num">{{item.produceDate || '未设置'}}</text>
      </view>
      <view class="ui-row">
        <text class="ui-row__label">过期日期</text>
        <text class="ui-row__value num">{{item.expireDate || '未设置'}}</text>
      </view>
    </view>

    <block wx:if="{{item.note}}">
      <text class="ui-section-title">备注</text>
      <view class="note">
        <text class="note__text">{{item.note}}</text>
      </view>
    </block>

    <text class="ui-section-title">记录</text>
    <view class="rows">
      <view class="ui-row">
        <text class="ui-row__label">添加时间</text>
        <text class="ui-row__value ui-row__value--meta">{{item.createdAt_display}}</text>
      </view>
      <view class="ui-row">
        <text class="ui-row__label">最后修改</text>
        <text class="ui-row__value ui-row__value--meta">{{item.updatedAt_display}}</text>
      </view>
    </view>

    <view class="actions">
      <button class="ui-btn is-block is-primary" bindtap="onEdit">编辑物品</button>
      <button class="ui-btn is-block is-danger" bindtap="onDelete">删除物品</button>
    </view>

    <view class="bottom-spacer"></view>
    </block>
    </view>
  </scroll-view>
</view>
