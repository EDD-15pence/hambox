/* ============================================================
 * 智能仓储 · 详情页（轻新拟物 v2）
 * 只写本页差异；材质、尺寸、颜色全部来自 styles/*
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

/* scroll-view 只负责滚动，不带任何横向 padding：
   它在部分机型上会把 padding 算到 100% 之外，导致内容右移、右侧被裁。
   页面边距一律交给内部 .page-body。 */
.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------- 主视觉：凸起相框 ---------- */
.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 320rpx;
  margin-top: var(--sp-1);
  overflow: hidden;
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.hero__image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero__emoji {
  font-size: 128rpx;
  line-height: 1;
}

/* ---------- 标题行 ---------- */
.headline {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin: var(--sp-3) 4rpx 0;
}

/* 复制名称：小字按钮，视觉弱但热区够 */
.headline__copy {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-tiny);
  color: var(--text-3);
  background: var(--bg-sunken);
}

.headline__copy:active {
  opacity: 0.6;
}

.headline__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-h2);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 倒计时：凹陷槽 + 大数字 ---------- */
.countdown {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-top: var(--sp-2);
  padding: var(--sp-4) var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.countdown__prefix {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.countdown__num {
  font-size: 88rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--text-1);
}

.countdown__num.is-expired {
  color: var(--danger);
}

.countdown__num.is-warning {
  color: var(--warning);
}

.countdown__num.is-fresh {
  color: var(--success);
}

.countdown__unit {
  font-size: var(--fs-body);
  color: var(--text-3);
}

.countdown__none {
  padding: var(--sp-2) 0;
  font-size: var(--fs-body);
  color: var(--text-3);
}

/* ---------- 信息行 ---------- */
.rows {
  display: flex;
  flex-direction: column;
}

.ui-row__value--meta {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ---------- 备注 ---------- */
.note {
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.note__text {
  display: block;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text-2);
  word-break: break-all;
}

.note__text.is-empty {
  color: var(--text-3);
}

.note__edit {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.note__input {
  width: 100%;
  min-height: 120rpx;
  padding: 0;
  background: transparent;
  box-shadow: none;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text-1);
}

.note__actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
}

.note__act {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.note__act.is-primary {
  font-weight: 600;
  color: var(--primary);
}

/* ---------- 操作 ---------- */
.actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin-top: var(--sp-6);
}

.bottom-spacer {
  height: calc(var(--sp-6) + env(safe-area-inset-bottom));
}

/* ---------- 加载骨架 ---------- */
.detail-skeleton {
  padding-top: var(--sp-2);
}

.detail-skeleton__hero {
  height: 240rpx;
  border-radius: var(--r-lg);
}

.detail-skeleton__line {
  height: 44rpx;
  width: 50%;
  margin-top: var(--sp-3);
  border-radius: var(--r-sm);
}

.detail-skeleton__block {
  height: 140rpx;
  margin-top: var(--sp-3);
  border-radius: var(--r-md);
}

.detail-skeleton__row {
  height: 84rpx;
  margin-top: var(--sp-2);
  border-radius: var(--r-sm);
}

/* ---------- 保质期进度 ---------- */
.progress {
  margin: var(--sp-2) 4rpx 0;
}

.progress__track {
  height: 16rpx;
  border-radius: var(--r-pill);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  overflow: hidden;
}

.progress__fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--primary);
  transition: width var(--dur-base) ease-out;
}

/* 颜色跟着状态走：快到期变橙、过期变红，扫一眼就知道紧不紧张 */
.progress--warning .progress__fill {
  background: var(--warning);
}

.progress--expired .progress__fill {
  background: var(--danger);
}

.progress__legend {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.progress__text {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.progress__pct {
  font-size: var(--fs-tiny);
  font-weight: 600;
  color: var(--text-2);
}
