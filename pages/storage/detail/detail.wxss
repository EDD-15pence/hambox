/* ============================== */
/* 智能仓储 - 详情页样式          */
/* ============================== */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
  color: #000000;
}

/* ---------- 导航栏 ---------- */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.nav-back {
  font-size: 28rpx;
  color: #007aff;
  min-width: 120rpx;
}
.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000000;
}
.navbar-actions {
  min-width: 120rpx;
  display: flex;
  justify-content: flex-end;
}
.icon-btn {
  background: transparent;
  border: none;
  padding: 8rpx 12rpx;
  font-size: 36rpx;
  line-height: 1;
  color: #000000;
}
.icon-btn::after {
  border: none;
}
.icon-hover {
  opacity: 0.6;
}

/* ---------- 内容滚动区 ---------- */
.detail-scroll {
  flex: 1;
}

/* ---------- 照片 ---------- */
.detail-image-wrap {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}
.detail-image {
  width: 100%;
  height: 100%;
}
.detail-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}
.detail-image-emoji {
  font-size: 120rpx;
}

/* ---------- 状态头部 ---------- */
.status-header {
  padding: 32rpx 24rpx;
  text-align: center;
}
.big-status-badge {
  display: inline-block;
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
}
.big-status-text {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.big-status-days {
  font-size: 26rpx;
  font-weight: 400;
}
/* 状态背景色 */
.status-bg-fresh {
  background: #e8f5e9;
}
.status-bg-fresh .big-status-text {
  color: #2e7d32;
}
.status-bg-fresh .big-status-days {
  color: #43a047;
}
.status-bg-warning {
  background: #fff3e0;
}
.status-bg-warning .big-status-text {
  color: #e65100;
}
.status-bg-warning .big-status-days {
  color: #f57c00;
}
.status-bg-expired {
  background: #fce4ec;
}
.status-bg-expired .big-status-text {
  color: #c62828;
}
.status-bg-expired .big-status-days {
  color: #e53935;
}
.status-bg-none {
  background: #f5f5f5;
}
.status-bg-none .big-status-text {
  color: #888888;
}
.status-bg-none .big-status-days {
  color: #aaaaaa;
}

/* ---------- 信息区域 ---------- */
.detail-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #888888;
}
.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
  word-break: break-all;
}
.detail-note {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
  display: block;
}

/* 高亮色 */
.highlight-fresh {
  color: #2e7d32;
  font-weight: 600;
}
.highlight-warning {
  color: #e65100;
  font-weight: 600;
}
.highlight-expired {
  color: #c62828;
  font-weight: 600;
}

.detail-meta {
  font-size: 24rpx;
  color: #aaaaaa;
}
.detail-section-meta {
  opacity: 0.7;
}

/* ---------- 操作按钮 ---------- */
.detail-actions {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.btn-edit {
  width: 100%;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  background: #007aff;
  color: #ffffff;
}
.btn-edit::after {
  border: none;
}
.btn-delete {
  width: 100%;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  background: transparent;
  color: #e53935;
}
.btn-delete::after {
  border: none;
}

.detail-bottom-spacer {
  height: 60rpx;
}

/* ============================== */
/* 暗黑模式                        */
/* ============================== */
.container.dark {
  background: #121212;
}
.container.dark .navbar {
  background: #1c1c1c;
  border-bottom-color: #2a2a2a;
}
.container.dark .navbar-title {
  color: #eaeaea;
}
.container.dark .icon-btn {
  color: #eaeaea;
}
.container.dark .detail-image-empty {
  background: #1a1a1a;
}
.container.dark .detail-section {
  background: #1c1c1c;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}
.container.dark .section-title {
  color: #eaeaea;
  border-bottom-color: #2a2a2a;
}
.container.dark .detail-row {
  border-bottom-color: #2a2a2a;
}
.container.dark .detail-label {
  color: #999999;
}
.container.dark .detail-value {
  color: #eaeaea;
}
.container.dark .detail-note {
  color: #cccccc;
}
.container.dark .detail-meta {
  color: #777777;
}
.container.dark .status-bg-fresh {
  background: #1b5e20;
}
.container.dark .status-bg-fresh .big-status-days {
  color: #a5d6a7;
}
.container.dark .status-bg-warning {
  background: #3e2723;
}
.container.dark .status-bg-warning .big-status-days {
  color: #ffb74d;
}
.container.dark .status-bg-expired {
  background: #4a1c1c;
}
.container.dark .status-bg-expired .big-status-days {
  color: #ef9a9a;
}
.container.dark .status-bg-none {
  background: #1a1a1a;
}
.container.dark .btn-delete {
  color: #ef5350;
}
