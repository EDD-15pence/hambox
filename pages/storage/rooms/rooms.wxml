<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <view class="app-nav__titles">
        <text class="app-nav__title">家里的收纳</text>
        <!-- 不再是「房间 › 柜子」那种路径：这一页本来就是房间，写数量更有用 -->
        <text class="app-nav__sub">{{roomCount}} 个房间 · {{total}} 个柜子</text>
      </view>
    </view>
    <view class="app-nav__actions">
      <text class="nav-icon-btn" bindtap="onToggleTheme">{{isDark ? '☀️' : '🌙'}}</text>
    </view>
  </view>

  <!-- 后端不可达：整页只剩排查卡 -->
  <view wx:if="{{error && !groups.length}}" class="page-scroll">
    <view class="page-body">
      <conn-error
        message="{{error}}"
        base-url="{{baseUrl}}"
        retrying="{{retrying}}"
        bind:retry="onRetry" />
    </view>
  </view>

  <view wx:elif="{{loading && !groups.length}}" class="page-scroll">
    <view class="page-body">
      <view class="ui-empty">
        <text class="ui-empty__title">正在取房间</text>
        <text class="ui-empty__hint">稍等一下</text>
      </view>
    </view>
  </view>

  <scroll-view wx:else class="page-scroll" scroll-y>
    <view class="page-body">
      <!-- 搜索常驻：找东西是这一页最高频的动作，不该先点一次「搜索」才出现输入框 -->
      <view class="search">
        <text class="search__icon">🔍</text>
        <input
          class="search__input"
          value="{{keyword}}"
          placeholder="搜物品：名字 / 位置 / 备注"
          placeholder-class="search__ph"
          confirm-type="search"
          bindinput="onSearchInput" />
        <text wx:if="{{keyword}}" class="search__clear" bindtap="onClearSearch">✕</text>
      </view>

      <view wx:if="{{error}}" class="ui-notice" bindtap="onRetry">
        <text class="ui-notice__text">这次没刷新成功 · {{error}}</text>
        <text class="ui-notice__action">重试</text>
      </view>

      <!-- 断网：显示的是本地缓存的旧数据，必须让人看出来（§10-2） -->
      <view wx:if="{{offlineText}}" class="ui-notice is-offline" bindtap="onRetry">
        <text class="ui-notice__text">{{offlineText}}</text>
        <text class="ui-notice__action">重试</text>
      </view>

      <!-- ==================== 搜索结果（有关键词时顶掉房间视图） ==================== -->
      <block wx:if="{{keyword}}">
        <view class="sr__head">
          <text class="sr__count">{{resultCount}} 件</text>
          <text class="sr__hint">按柜子归位，点一条进柜子</text>
        </view>

        <view wx:for="{{results}}" wx:key="id" class="sr" data-cab="{{item.cabId}}" bindtap="onOpenResult" hover-class="sr--active" hover-stay-time="80">
          <text class="sr__icon">{{item.emoji}}</text>
          <view class="sr__main">
            <text class="sr__name">{{item.name}}</text>
            <text class="sr__meta">{{item.cabText}} · {{item.locationText}}</text>
          </view>
          <text class="sr__qty num">{{item.quantityText}}</text>
        </view>

        <view wx:if="{{resultMore}}" class="sr__more">
          <text class="sr__more-text">还有 {{resultMore}} 件没列出来，再输几个字缩小范围</text>
        </view>

        <view wx:if="{{!resultCount}}" class="ui-empty">
          <text class="ui-empty__icon">🔍</text>
          <text class="ui-empty__title">没找到「{{keyword}}」</text>
          <text class="ui-empty__hint">试试物品名的一两个字，或者写信箱里的位置（比如「冰箱」）。</text>
        </view>
      </block>

      <!-- ==================== 房间视图 ==================== -->
      <block wx:else>
        <!-- ==================== 房间分组 ==================== -->
        <view wx:for="{{groups}}" wx:key="id" class="group">
          <view class="group__head">
            <text class="group__icon">{{item.icon}}</text>
            <view class="group__title">
              <text class="group__name">{{item.name}}</text>
              <text class="group__sub">{{item.count}} 个柜子</text>
            </view>
            <view class="group__ops">
              <text
                wx:if="{{index > 0}}"
                class="op"
                data-index="{{index}}"
                data-delta="-1"
                bindtap="onMoveRoom">↑</text>
              <text
                wx:if="{{index !== groups.length - 1}}"
                class="op"
                data-index="{{index}}"
                data-delta="1"
                bindtap="onMoveRoom">↓</text>
              <text class="op" data-id="{{item.id}}" bindtap="onEditRoom">改</text>
              <text
                class="op op--danger"
                data-id="{{item.id}}"
                data-name="{{item.name}}"
                data-count="{{item.count}}"
                bindtap="onDeleteRoom">删</text>
            </view>
          </view>

          <text wx:if="{{item.dupNames.length}}" class="group__warn">
            同房间有两个「{{item.dupNames[0]}}」，建议把「房间 + 柜子」写进关键字
          </text>

          <view class="cabs">
            <view
              wx:for="{{item.containers}}"
              wx:for-item="cab"
              wx:key="id"
              class="cab"
              data-id="{{cab.id}}"
              bindtap="onOpenContainer"
              hover-class="cab--active"
              hover-stay-time="80">
              <text class="cab__icon">{{cab.icon}}</text>
              <text class="cab__name">{{cab.name}}</text>
              <text class="cab__meta">{{cab.rowsText}} · {{cab.countText}}</text>
              <text wx:if="{{cab.isBuiltin}}" class="cab__tag">内置</text>
            </view>

            <view class="cab cab--add" data-room="{{item.id}}" bindtap="onAddContainer">
              <text class="cab__plus">＋</text>
              <text class="cab__addtext">柜子</text>
            </view>
          </view>

          <view wx:if="{{!item.containers.length}}" class="group__empty">
            <text class="group__empty-text">这个房间还没有柜子</text>
          </view>
        </view>

        <!-- ==================== 未分组 ==================== -->
        <view wx:if="{{ungroupedCount}}" class="group">
          <view class="group__head">
            <text class="group__icon">📦</text>
            <view class="group__title">
              <text class="group__name">未分组</text>
              <text class="group__sub">{{ungroupedCount}} 个柜子</text>
            </view>
          </view>
          <text class="group__warn is-hint">这些柜子还没分到房间，点开就能选。</text>
          <view class="cabs">
            <view
              wx:for="{{ungrouped}}"
              wx:for-item="cab"
              wx:key="id"
              class="cab"
              data-id="{{cab.id}}"
              bindtap="onOpenContainer"
              hover-class="cab--active"
              hover-stay-time="80">
              <text class="cab__icon">{{cab.icon}}</text>
              <text class="cab__name">{{cab.name}}</text>
              <text class="cab__meta">{{cab.rowsText}} · {{cab.countText}}</text>
            </view>
          </view>
        </view>

        <!-- 一个房间都没有：下面就是新建入口，这里只交代一句 -->
        <view wx:if="{{!groups.length && !ungroupedCount}}" class="ui-empty">
          <text class="ui-empty__icon">🏠</text>
          <text class="ui-empty__title">还没建过房间</text>
          <text class="ui-empty__hint">先建「厨房」「主卧」这样的房间，再把柜子放进去。之后记东西时说「阳台柜」也能认出位置。</text>
        </view>

        <!-- 新建房间：从导航挪到页面最下面（导航留给搜索和标题） -->
        <button class="ui-btn is-block add-room" bindtap="onCreateRoom">＋ 新建房间</button>

        <!-- 清单页的唯一入口。导航腾空后不能把它弄丢：按过期排序、按分类看只有那边有 -->
        <view class="foot-links">
          <text class="foot-link" bindtap="onOpenList">按清单看（排序 / 分类）›</text>
        </view>

        <view class="tip">
          <text class="tip__text">房间只是分组：删房间、搬柜子都不会丢东西，东西还是靠位置归位。</text>
        </view>

        <view class="bottom-space"></view>
      </block>
    </view>
  </scroll-view>

  <!-- ==================== 房间编辑面板 ==================== -->
  <view wx:if="{{editor}}" class="ui-mask" bindtap="onCloseEditor">
    <view class="ui-sheet" catchtap="noop">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">{{editor.mode === 'create' ? '新建房间' : '修改房间'}}</text>
        <text class="nav-text-btn" bindtap="onCloseEditor">关闭</text>
      </view>

      <view class="field">
        <text class="field__label">叫什么</text>
        <input
          class="ui-input"
          value="{{editor.name}}"
          placeholder="房间名称，比如次卧、阳台"
          placeholder-class="ui-placeholder"
          maxlength="12"
          bindinput="onEditorName" />
      </view>

      <view class="field">
        <text class="field__label">图标</text>
        <view class="chip-row">
          <text
            wx:for="{{icons}}"
            wx:key="*this"
            class="chip chip--icon {{editor.icon === item ? 'is-on' : ''}}"
            data-icon="{{item}}"
            catchtap="onPickIcon">{{item}}</text>
        </view>
      </view>

      <button
        class="ui-btn is-primary is-block save-btn"
        disabled="{{saving}}"
        bindtap="onSaveRoom">{{saving ? '保存中…' : '保存'}}</button>
    </view>
  </view>
</view>
