<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <view class="app-nav__titles">
        <text class="app-nav__title">整理收纳</text>
        <text class="app-nav__sub">房间 › 柜子</text>
      </view>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onCreateRoom">＋ 房间</text>
      <text class="nav-text-btn" bindtap="onToggleTheme">{{isDark ? '日间' : '夜间'}}</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body">
      <view wx:if="{{loading && !groups.length}}" class="ui-empty">
        <text class="ui-empty__title">正在取房间</text>
        <text class="ui-empty__hint">稍等一下</text>
      </view>

      <conn-error
        wx:elif="{{error && !groups.length}}"
        message="{{error}}"
        base-url="{{baseUrl}}"
        retrying="{{retrying}}"
        bind:retry="onRetry" />

      <block wx:else>
        <view wx:if="{{error}}" class="ui-notice" bindtap="onRetry">
          <text class="ui-notice__text">这次没刷新成功 · {{error}}</text>
          <text class="ui-notice__action">重试</text>
        </view>

        <view class="tip">
          <text class="tip__text">房间只是分组：删房间、搬柜子都不会丢东西，东西还是靠位置归位。</text>
        </view>

        <!-- ==================== 房间分组 ==================== -->
        <view wx:for="{{groups}}" wx:key="id" class="group">
          <view class="group__head">
            <text class="group__icon">{{item.icon}}</text>
            <view class="group__title">
              <text class="group__name">{{item.name}}</text>
              <text class="group__sub">{{item.count}} 个柜子</text>
            </view>
            <view class="group__ops">
              <text
                wx:if="{{index > 0}}"
                class="op"
                data-index="{{index}}"
                data-delta="-1"
                bindtap="onMoveRoom">↑</text>
              <text
                wx:if="{{index !== groups.length - 1}}"
                class="op"
                data-index="{{index}}"
                data-delta="1"
                bindtap="onMoveRoom">↓</text>
              <text class="op" data-id="{{item.id}}" bindtap="onEditRoom">改</text>
              <text
                class="op op--danger"
                data-id="{{item.id}}"
                data-name="{{item.name}}"
                data-count="{{item.count}}"
                bindtap="onDeleteRoom">删</text>
            </view>
          </view>

          <text wx:if="{{item.dupNames.length}}" class="group__warn">
            同房间有两个「{{item.dupNames[0]}}」，建议把「房间 + 柜子」写进关键字
          </text>

          <view class="cabs">
            <view
              wx:for="{{item.containers}}"
              wx:for-item="cab"
              wx:key="id"
              class="cab"
              data-id="{{cab.id}}"
              bindtap="onOpenContainer"
              hover-class="cab--active"
              hover-stay-time="80">
              <text class="cab__icon">{{cab.icon}}</text>
              <text class="cab__name">{{cab.name}}</text>
              <text class="cab__meta">{{cab.rowsText}} · {{cab.countText}}</text>
              <text wx:if="{{cab.isBuiltin}}" class="cab__tag">内置</text>
            </view>

            <view class="cab cab--add" data-room="{{item.id}}" bindtap="onAddContainer">
              <text class="cab__plus">＋</text>
              <text class="cab__addtext">柜子</text>
            </view>
          </view>

          <view wx:if="{{!item.containers.length}}" class="group__empty">
            <text class="group__empty-text">这个房间还没有柜子</text>
          </view>
        </view>

        <!-- ==================== 未分组 ==================== -->
        <view wx:if="{{ungroupedCount}}" class="group">
          <view class="group__head">
            <text class="group__icon">📦</text>
            <view class="group__title">
              <text class="group__name">未分组</text>
              <text class="group__sub">{{ungroupedCount}} 个柜子</text>
            </view>
          </view>
          <text class="group__warn is-hint">这些柜子还没分到房间，点开就能选。</text>
          <view class="cabs">
            <view
              wx:for="{{ungrouped}}"
              wx:for-item="cab"
              wx:key="id"
              class="cab"
              data-id="{{cab.id}}"
              bindtap="onOpenContainer"
              hover-class="cab--active"
              hover-stay-time="80">
              <text class="cab__icon">{{cab.icon}}</text>
              <text class="cab__name">{{cab.name}}</text>
              <text class="cab__meta">{{cab.rowsText}} · {{cab.countText}}</text>
            </view>
          </view>
        </view>

        <!-- 一个房间都没有：直接引导 -->
        <view wx:if="{{!groups.length && !ungroupedCount}}" class="ui-empty">
          <text class="ui-empty__icon">🏠</text>
          <text class="ui-empty__title">还没建过房间</text>
          <text class="ui-empty__hint">先建「厨房」「卧室」这样的房间，再把柜子放进去。之后记东西时说「阳台柜」也能认出位置。</text>
          <button class="ui-btn is-primary ui-empty__action" bindtap="onCreateRoom">＋ 新建房间</button>
        </view>

        <view class="bottom-space"></view>
      </block>
    </view>
  </scroll-view>

  <!-- ==================== 房间编辑面板 ==================== -->
  <view wx:if="{{editor}}" class="ui-mask" bindtap="onCloseEditor">
    <view class="ui-sheet" catchtap="noop">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">{{editor.mode === 'create' ? '新建房间' : '修改房间'}}</text>
        <text class="nav-text-btn" bindtap="onCloseEditor">关闭</text>
      </view>

      <view class="field">
        <text class="field__label">叫什么</text>
        <input
          class="ui-input"
          value="{{editor.name}}"
          placeholder="房间名称，比如次卧、阳台"
          placeholder-class="ui-placeholder"
          maxlength="12"
          bindinput="onEditorName" />
      </view>

      <view class="field">
        <text class="field__label">图标</text>
        <view class="chip-row">
          <text
            wx:for="{{icons}}"
            wx:key="*this"
            class="chip chip--icon {{editor.icon === item ? 'is-on' : ''}}"
            data-icon="{{item}}"
            catchtap="onPickIcon">{{item}}</text>
        </view>
      </view>

      <button
        class="ui-btn is-primary is-block save-btn"
        disabled="{{saving}}"
        bindtap="onSaveRoom">{{saving ? '保存中…' : '保存'}}</button>
    </view>
  </view>
</view>
