<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <view class="app-nav__titles">
        <text class="app-nav__title">{{step === 1 ? '收拾一下' : '每个房间放什么'}}</text>
        <text class="app-nav__sub">第 {{step}} / 2 步</text>
      </view>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onSkip">跳过</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body">
      <!-- 后端不可达：不进引导、不置位（§21.9 第 5 项） -->
      <conn-error
        wx:if="{{error}}"
        message="{{error}}"
        base-url="{{baseUrl}}"
        retrying="{{retrying}}"
        bind:retry="onRetry" />

      <view wx:elif="{{loading}}" class="ui-empty">
        <text class="ui-empty__title">正在看看家里有什么</text>
        <text class="ui-empty__hint">稍等一下</text>
      </view>

      <!-- ==================== 步 1：勾房间 ==================== -->
      <block wx:elif="{{step === 1}}">
        <view class="lead">
          <text class="lead__title">你家有哪些房间？</text>
          <text class="lead__desc">勾上就建。只想要一两个也行，以后随时能在「整理」里加。</text>
        </view>

        <view class="picks">
          <view
            wx:for="{{presets}}"
            wx:key="name"
            class="pick {{item.checked ? 'is-on' : ''}}"
            data-index="{{index}}"
            bindtap="onToggleRoom"
            hover-class="pick--active"
            hover-stay-time="60">
            <text class="pick__icon">{{item.icon}}</text>
            <text class="pick__name">{{item.name}}</text>
            <text wx:if="{{item.custom}}" class="pick__x" data-index="{{index}}" catchtap="onRemoveCustom">×</text>
            <text wx:elif="{{item.checked}}" class="pick__tick">✓</text>
          </view>
        </view>

        <view class="custom">
          <input
            class="ui-input custom__input"
            value="{{customName}}"
            placeholder="还有别的房间？比如次卧"
            placeholder-class="ui-placeholder"
            maxlength="12"
            bindinput="onCustomInput"
            bindconfirm="onAddCustom" />
          <text class="custom__add" bindtap="onAddCustom">添加</text>
        </view>
      </block>

      <!-- ==================== 步 2：勾柜子 ==================== -->
      <block wx:else>
        <view class="lead">
          <text class="lead__title">每个房间里有什么柜子？</text>
          <text class="lead__desc">点一个加一个。有几个一样的就调「个数」，会建成几个独立的柜子。</text>
        </view>

        <view wx:for="{{rooms}}" wx:for-item="room" wx:for-index="ri" wx:key="name" class="room">
          <view class="room__head">
            <text class="room__icon">{{room.icon}}</text>
            <text class="room__name">{{room.name}}</text>
          </view>

          <view class="cabs-pick">
            <view
              wx:for="{{room.containers}}"
              wx:for-item="cab"
              wx:for-index="ci"
              wx:key="key"
              class="cab-pick {{cab.on ? 'is-on' : ''}}"
              data-ri="{{ri}}"
              data-ci="{{ci}}"
              bindtap="onToggleCab">
              <text class="cab-pick__icon">{{cab.icon}}</text>
              <text class="cab-pick__name">{{cab.label}}</text>
            </view>
          </view>

          <!-- 已勾选的柜子：个数 / 层数 / 名字 -->
          <block wx:for="{{room.containers}}" wx:for-item="cab" wx:for-index="ci" wx:key="key">
            <view wx:if="{{cab.on}}" class="cfg">
              <input
                class="ui-input cfg__name"
                value="{{cab.name}}"
                placeholder="柜子名字"
                placeholder-class="ui-placeholder"
                maxlength="12"
                data-ri="{{ri}}"
                data-ci="{{ci}}"
                bindinput="onCabName" />

              <view class="cfg__row">
                <view class="cfg__step">
                  <text class="cfg__label">几个</text>
                  <view class="step">
                    <text class="step__btn" data-ri="{{ri}}" data-ci="{{ci}}" data-field="count" data-delta="-1" catchtap="onStep">−</text>
                    <text class="step__num num">{{cab.count}}</text>
                    <text class="step__btn" data-ri="{{ri}}" data-ci="{{ci}}" data-field="count" data-delta="1" catchtap="onStep">＋</text>
                  </view>
                </view>
                <view class="cfg__step">
                  <text class="cfg__label">几层（0 = 自动）</text>
                  <view class="step">
                    <text class="step__btn" data-ri="{{ri}}" data-ci="{{ci}}" data-field="rows" data-delta="-1" catchtap="onStep">−</text>
                    <text class="step__num num">{{cab.rows}}</text>
                    <text class="step__btn" data-ri="{{ri}}" data-ci="{{ci}}" data-field="rows" data-delta="1" catchtap="onStep">＋</text>
                  </view>
                </view>
              </view>
            </view>
          </block>

          <text wx:if="{{!room.containers.length}}" class="room__empty">这个房间先空着也行</text>
        </view>

        <view class="note">
          <text class="note__text">之后想加房间、搬柜子、改层数，都在容器墙右上角的「整理」里。</text>
        </view>
      </block>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view class="bottom">
    <text wx:if="{{saving}}" class="bottom__progress">{{progressText}}</text>
    <button
      wx:if="{{step === 1}}"
      class="ui-btn is-primary is-block"
      bindtap="onNext">下一步</button>
    <block wx:else>
      <button class="ui-btn is-block bottom__prev" bindtap="onPrev">上一步</button>
      <button
        class="ui-btn is-primary is-block bottom__next"
        disabled="{{saving}}"
        bindtap="onFinish">{{saving ? '正在建…' : '完成'}}</button>
    </block>
  </view>
</view>
