<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <view class="app-nav__titles">
        <text class="app-nav__title">{{step === 1 ? '收拾一下' : '每个房间放什么'}}</text>
        <text class="app-nav__sub">第 {{step}} / 2 步</text>
      </view>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onWizardSkip">跳过</text>
    </view>
  </view>

  <!-- 后端不可达：不进引导、不置位（§21.9 第 5 项） -->
  <view wx:if="{{error}}" class="page-scroll">
    <view class="page-body">
      <conn-error
        message="{{error}}"
        base-url="{{baseUrl}}"
        retrying="{{retrying}}"
        bind:retry="onRetry" />
    </view>
  </view>

  <view wx:elif="{{loading}}" class="page-scroll">
    <view class="page-body">
      <view class="ui-empty">
        <text class="ui-empty__title">正在看看家里有什么</text>
        <text class="ui-empty__hint">稍等一下</text>
      </view>
    </view>
  </view>

  <!-- 两步流程都在组件里（RM-08）：整理页复用同一份 -->
  <room-wizard
    wx:else
    id="wz"
    existing-rooms="{{existingRooms}}"
    existing-containers="{{existingContainers}}"
    bind:stepchange="onWizardStep"
    bind:done="onWizardDone"
    bind:skip="onWizardSkip" />
</view>
