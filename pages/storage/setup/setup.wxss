/* ============================================================
 * 智能仓储 · 首启引导（RM-02 / §21.5）
 *
 * 1.3.18 起这一页只是壳：两步的界面与样式全在
 * `components/room-wizard`（整理页也要复用同一套）。
 * 所以这里只剩页面骨架 + 加载/错误态。
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

.app-nav {
  position: sticky;
  top: 0;
  z-index: 20;
}

.page-scroll {
  flex: 1;
  box-sizing: border-box;
  min-height: 0;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: var(--sp-2) var(--page-x) 0;
}
