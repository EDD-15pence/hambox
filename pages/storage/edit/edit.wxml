<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">{{isEdit ? '编辑物品' : '添加物品'}}</text>
    </view>
    <view class="app-nav__actions"></view>
  </view>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body">
    <!-- 编辑模式：原物品还没拉回来 -->
    <block wx:if="{{loading}}">
      <view class="edit-skeleton">
        <view class="edit-skeleton__title ui-skeleton"></view>
        <view class="edit-skeleton__row ui-skeleton" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
      </view>
    </block>

    <!-- 编辑模式且拉不到：留在原地给连接引导，别把人弹出去 -->
    <conn-error
      wx:elif="{{loadError && isEdit}}"
      message="{{loadError}}"
      base-url="{{baseUrl}}"
      retrying="{{retrying}}"
      bind:retry="onRetry" />

    <block wx:else>
    <!-- 新增模式下拉分类失败：表单照填，只是分类少一项 -->
    <view wx:if="{{loadError}}" class="ui-notice" bindtap="onRetry">
      <text class="ui-notice__text">分类没拉到 · {{loadError}}</text>
      <text class="ui-notice__action">重试</text>
    </view>

    <text class="ui-section-title">基本信息</text>

    <view class="field">
      <text class="field__label">名称 <text class="field__required">必填</text></text>
      <input class="ui-input"
        placeholder="例如：可口可乐 330ml"
        placeholder-class="ui-placeholder"
        value="{{item.name}}"
        bindinput="onFieldInput"
        data-field="name"
        maxlength="30" />
    </view>

    <view class="field">
      <text class="field__label">分类</text>
      <picker mode="selector" range="{{categoryNames}}" bindchange="onCategoryChange">
        <view class="picker">
          <text class="{{selectedCategoryName ? 'picker__text' : 'picker__placeholder'}}">{{selectedCategoryName || '请选择分类'}}</text>
          <text class="picker__arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">数量</text>
      <view class="qty-row">
        <input class="ui-input qty-row__input"
          type="number"
          placeholder="数量"
          placeholder-class="ui-placeholder"
          value="{{item.quantity}}"
          bindinput="onFieldInput"
          data-field="quantity" />
        <picker mode="selector" range="{{presetUnits}}" bindchange="onUnitChange">
          <view class="picker qty-row__unit">
            <text class="picker__text">{{item.unit || '单位'}}</text>
            <text class="picker__arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="field">
      <text class="field__label">存放位置</text>
      <input class="ui-input"
        placeholder="例如：厨房上层橱柜"
        placeholder-class="ui-placeholder"
        value="{{item.location}}"
        bindinput="onFieldInput"
        data-field="location"
        maxlength="50" />
    </view>

    <text class="ui-section-title">保质期</text>

    <view class="field">
      <text class="field__label">生产日期</text>
      <picker mode="date" bindchange="onProduceDateChange" value="{{item.produceDate}}">
        <view class="picker">
          <text class="{{item.produceDate ? 'picker__text' : 'picker__placeholder'}}">{{item.produceDate || '选择日期'}}</text>
          <text class="picker__arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field__label">过期时间</text>
      <!-- 分段控件：轨道凹陷，选中项凸起 -->
      <view class="segmented">
        <view class="segmented__item {{expiryMode === 'date' ? 'is-on' : ''}}"
          bindtap="onSelectExpiryMode" data-mode="date">直接选日期</view>
        <view class="segmented__item {{expiryMode === 'months' ? 'is-on' : ''}}"
          bindtap="onSelectExpiryMode" data-mode="months">按月计算</view>
      </view>

      <view wx:if="{{expiryMode === 'date'}}" class="field__sub">
        <picker mode="date" bindchange="onExpireDateChange" value="{{item.expireDate}}">
          <view class="picker">
            <text class="{{item.expireDate ? 'picker__text' : 'picker__placeholder'}}">{{item.expireDate || '选择过期日期'}}</text>
            <text class="picker__arrow">›</text>
          </view>
        </picker>
      </view>

      <view wx:if="{{expiryMode === 'months'}}" class="field__sub">
        <view class="months-row">
          <input class="ui-input months-row__input"
            type="digit"
            placeholder="输入月数"
            placeholder-class="ui-placeholder"
            value="{{expiryMonths}}"
            bindinput="onMonthsInput" />
          <text class="months-row__unit">个月</text>
        </view>
        <view wx:if="{{calculatedExpire}}" class="hint">
          <text class="hint__text">预计过期日 {{calculatedExpire}}</text>
          <text wx:if="{{calculatedStatusText}}" class="ui-badge is-{{calculatedStatus === 'expired' ? 'expired' : (calculatedStatus === 'warning' ? 'warning' : 'fresh')}}">{{calculatedStatusText}}</text>
        </view>
      </view>
    </view>

    <text class="ui-section-title">备注</text>
    <view class="field">
      <textarea class="ui-textarea"
        placeholder="添加备注信息…"
        placeholder-class="ui-placeholder"
        value="{{item.note}}"
        bindinput="onFieldInput"
        data-field="note"
        maxlength="200"
        auto-height />
    </view>

    <text class="ui-section-title">照片</text>
    <view class="photo">
      <image wx:if="{{item.imageSrc}}" class="photo__preview" src="{{item.imageSrc}}" mode="aspectFill" bindtap="onChoosePhoto" />
      <button class="ui-btn photo__btn" bindtap="onChoosePhoto">{{item.imageSrc ? '重新选择照片' : '选择照片'}}</button>
    </view>

    <view class="form-actions">
      <button class="ui-btn is-block" bindtap="onBack">取消</button>
      <button class="ui-btn is-block is-primary" bindtap="onSave" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
    </view>

    <view wx:if="{{isEdit}}" class="delete-block">
      <button class="ui-btn is-block is-danger" bindtap="onDelete">删除此物品</button>
    </view>

    <view class="bottom-spacer"></view>
    </block>
    </view>
  </scroll-view>
  <feedback-fab spacer="{{false}}" />
</view>
