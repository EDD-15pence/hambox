/* ============================================================
 * 智能仓储 · 添加/编辑页（轻新拟物 v2）
 * 表单的通篇逻辑：能输入的控件都是凹的，能点的按钮都是凸的
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

/* scroll-view 只负责滚动，不带任何横向 padding：
   它在部分机型上会把 padding 算到 100% 之外，导致内容右移、右侧被裁。
   页面边距一律交给内部 .page-body。 */
.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------- 字段 ---------- */
.field {
  margin-bottom: var(--sp-3);
}

.field__label {
  display: block;
  margin: 0 4rpx 10rpx;
  font-size: var(--fs-tiny);
  font-weight: 500;
  color: var(--text-3);
}

.field__required {
  margin-left: 8rpx;
  font-size: var(--fs-tiny);
  color: var(--danger);
}

.field__sub {
  margin-top: var(--sp-1);
}

/* 选择器：和输入框一致的凹陷槽 */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: var(--hit);
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.picker__text {
  font-size: var(--fs-body);
  color: var(--text-1);
}

.picker__placeholder {
  font-size: var(--fs-body);
  color: var(--text-3);
}

.picker__arrow {
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-3);
}

/* ---------- 数量 + 单位 ---------- */
.qty-row {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.qty-row__input {
  flex: 1;
  min-width: 0;
}

.qty-row__unit {
  width: 180rpx;
}

/* ---------- 分段控件：轨道凹陷，选中项凸起 ---------- */
.segmented {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.segmented__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: var(--r-sm);
  font-size: var(--fs-caption);
  color: var(--text-3);
  transition: box-shadow var(--dur-fast) ease-out, color var(--dur-fast) ease-out;
}

.segmented__item.is-on {
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  color: var(--text-1);
  font-weight: 600;
}

/* ---------- 按月计算 ---------- */
.months-row {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.months-row__input {
  flex: 1;
  min-width: 0;
}

.months-row__unit {
  flex: none;
  font-size: var(--fs-body);
  color: var(--text-3);
}

.hint {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
  padding: 0 4rpx;
}

.hint__text {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* ---------- 照片 ---------- */
.photo {
  margin-bottom: var(--sp-3);
}

.photo__preview {
  display: block;
  width: 100%;
  height: 320rpx;
  margin-bottom: var(--sp-2);
  border-radius: var(--r-lg);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.photo__btn {
  width: 100%;
}

/* ---------- 操作区 ---------- */
.form-actions {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.delete-block {
  margin-top: var(--sp-2);
}

/* 底部留白：气泡 fixed 占 24~96rpx，留到 148rpx 才不会盖住保存按钮 */
.bottom-spacer {
  height: calc(148rpx + env(safe-area-inset-bottom));
}

/* ---------- 加载骨架 ---------- */
.edit-skeleton {
  padding-top: var(--sp-2);
}

.edit-skeleton__title {
  height: 32rpx;
  width: 30%;
  border-radius: var(--r-sm);
}

.edit-skeleton__row {
  height: var(--hit);
  margin-top: var(--sp-3);
  border-radius: var(--r-md);
}
