<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">{{view === 'inside' ? active.name : (organizing ? '整理收纳' : '家里的收纳')}}</text>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn {{showSearch ? 'is-on' : ''}}" bindtap="onToggleSearch">搜索</text>
      <text
        wx:if="{{view === 'inside'}}"
        class="nav-text-btn"
        bindtap="onEditActive">编辑</text>
      <text
        wx:else
        class="nav-text-btn {{organizing ? 'is-on' : ''}}"
        bindtap="onToggleOrganize">{{organizing ? '完成' : '整理'}}</text>
      <text class="nav-text-btn" bindtap="onToggleTheme">{{isDark ? '日间' : '夜间'}}</text>
    </view>
  </view>

  <!-- 容器 / 清单：同一份数据的两种看法，切换不堆页面栈 -->
  <view class="ui-segment-wrap">
    <view class="ui-segment">
      <text class="ui-segment__item is-on" data-mode="containers" bindtap="onSwitchMode">容器</text>
      <text class="ui-segment__item" data-mode="list" bindtap="onSwitchMode">清单</text>
    </view>
  </view>

  <!-- 拖拽时不能滚，否则手势被 scroll-view 吃掉 -->
  <scroll-view class="page-scroll" scroll-y="{{!drag && !pdrag}}">
    <view class="page-body">
    <!-- 加载中 -->
    <block wx:if="{{loading && !wall.length}}">
      <view class="wall-skeleton">
        <view class="wall-skeleton__card ui-skeleton" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
      </view>
    </block>

    <!-- 连不上后端 -->
    <conn-error
      wx:elif="{{loadError && !wall.length}}"
      message="{{loadError}}"
      base-url="{{baseUrl}}"
      retrying="{{retrying}}"
      bind:retry="onRetry" />

    <block wx:else>
    <!-- ==================== 容器墙 ==================== -->
    <block wx:if="{{view === 'wall'}}">
      <view wx:if="{{loadError}}" class="ui-notice" bindtap="onRetry">
        <text class="ui-notice__text">这次没刷新成功 · {{loadError}}</text>
        <text class="ui-notice__action">重试</text>
      </view>

      <!-- 在路上：买了还没到的，拖到柜子里就算放好了；也可以多选一次放完 -->
      <view wx:if="{{pendingCount > 0}}" class="pending">
        <view class="pending__head">
          <text class="pending__title">在路上</text>
          <text class="pending__count num">{{pendingCount}}</text>
          <text wx:if="{{!pendingSelect}}" class="pending__hint">长按拖进柜子</text>
          <text wx:else class="pending__hint">点一下勾选</text>
          <text
            wx:if="{{pendingCount > 1}}"
            class="pending__multi"
            bindtap="onTogglePendingSelect">{{pendingSelect ? '退出多选' : '多选'}}</text>
        </view>
        <scroll-view class="pending__list" scroll-x enable-flex>
          <view
            wx:for="{{pending}}" wx:key="id"
            class="pchip {{pendingSelect ? 'is-selectable' : ''}} {{pendingChecked[item.id] ? 'is-checked' : ''}}"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-emoji="{{item.emoji}}"
            bindlongpress="onPendingLongPress"
            bindtouchmove="onPendingDragMove"
            bindtouchend="onPendingDragEnd"
            bindtap="onPendingTap">
            <view wx:if="{{pendingSelect}}" class="pchip__check">
              <text wx:if="{{pendingChecked[item.id]}}" class="pchip__tick">✓</text>
            </view>
            <view class="pchip__pic">
              <image wx:if="{{item.imageSrc}}" class="pchip__img" src="{{item.imageSrc}}" mode="aspectFill" />
              <text wx:else class="pchip__emoji">{{item.emoji}}</text>
              <text wx:if="{{item.qtyText}}" class="pchip__qty num">{{item.qtyText}}</text>
            </view>
            <text class="pchip__name">{{item.name}}</text>
            <text class="pchip__days">{{item.waitText}}</text>
            <text wx:if="{{!pendingSelect}}" class="pchip__del" data-id="{{item.id}}" catchtap="onDeletePending">✕</text>
          </view>
        </scroll-view>
      </view>

      <!-- 挑选态：点哪个柜子就把这些在途放进去 -->
      <view wx:if="{{picking && picking.length}}" class="picking-bar">
        <text class="picking-bar__text">{{pickingText}}</text>
        <text class="picking-bar__cancel" bindtap="onCancelPicking">取消</text>
      </view>

      <view class="summary">
        <block wx:if="{{keyword}}">
          <text class="summary__num num">{{hitTotal}}</text>
          <text class="summary__label">件命中，在 {{wall.length}} 个地方</text>
        </block>
        <block wx:else>
          <text class="summary__num num">{{total}}</text>
          <text class="summary__label">件东西，分在 {{wall.length}} 个地方</text>
          <text wx:if="{{expired > 0}}" class="summary__flag is-danger">过期 {{expired}}</text>
          <text wx:if="{{warning > 0}}" class="summary__flag is-warning">临期 {{warning}}</text>
        </block>
      </view>

      <!-- 搜名字 / 位置：命中的柜子会留在墙上，柜子里那几件亮着 -->
      <view wx:if="{{showSearch}}" class="ui-search">
        <input
          class="ui-input ui-search__input"
          placeholder="搜名称 / 位置，比如 可乐"
          placeholder-class="ui-placeholder"
          value="{{keyword}}"
          bindinput="onSearchInput"
          confirm-type="search"
          focus="{{showSearch}}" />
        <text wx:if="{{keyword}}" class="ui-search__clear" bindtap="onClearSearch">清空</text>
      </view>

      <view class="wall {{picking ? 'is-picking' : ''}}">
        <view
          wx:for="{{wall}}" wx:key="id"
          class="cab {{item.empty ? 'is-empty' : ''}} {{dragOver === item.id ? 'is-drop' : ''}}"
          data-id="{{item.id}}"
          bindtap="onOpenContainer"
          hover-class="cab--pressed"
          hover-stay-time="60">

          <!-- 物件本身：不同的收纳画不同的样子 -->
          <view class="cab__stage">
            <!-- 冰箱：上冷冻下冷藏的双门 -->
            <view wx:if="{{item.skin === 'fridge'}}" class="obj obj--fridge">
              <view class="fridge__door fridge__door--freezer"></view>
              <view class="fridge__door fridge__door--chill">
                <view class="fridge__drawer"></view>
              </view>
              <view class="fridge__handle"></view>
              <view class="fridge__led"></view>
            </view>

            <!-- 对开柜 / 玻璃门柜 -->
            <view wx:elif="{{item.skin === 'door2' || item.skin === 'glass'}}" class="obj obj--{{item.skin}}">
              <!-- 玻璃门柜：先铺一层淡淡的 emoji，再盖上透光的门 -->
              <view wx:if="{{item.skin === 'glass'}}" class="glass__inside">
                <text class="glass__ghost" wx:for="{{item.preview}}" wx:for-item="pe" wx:key="k">{{pe.e}}</text>
              </view>
              <view class="cab2__panel cab2__panel--l">
                <view class="cab2__knob"></view>
              </view>
              <view class="cab2__panel cab2__panel--r">
                <view class="cab2__knob"></view>
              </view>
              <view wx:if="{{item.skin === 'glass'}}" class="glass__shine"></view>
            </view>

            <!-- 药箱 -->
            <view wx:elif="{{item.skin === 'medical'}}" class="obj obj--medical">
              <view class="medical__handle"></view>
              <view class="medical__lid"></view>
              <view class="medical__cross">
                <view class="cross__h"></view>
                <view class="cross__v"></view>
              </view>
            </view>

            <!-- 开放置物架 -->
            <view wx:elif="{{item.skin === 'rack'}}" class="obj obj--rack">
              <view class="rack__post rack__post--l"></view>
              <view class="rack__post rack__post--r"></view>
              <view class="rack__board rack__board--1"></view>
              <view class="rack__board rack__board--2"></view>
              <view class="rack__board rack__board--3"></view>
            </view>

            <!-- 纸箱（未归位 / 自定义选了纸箱） -->
            <view wx:else class="obj obj--carton">
              <view class="carton__flap"></view>
              <view class="carton__tape"></view>
              <view class="carton__seam"></view>
            </view>

            <view class="cab__ground"></view>
            <text wx:if="{{organizing && item.deletable}}" class="cab__edit">改</text>
          </view>

          <view class="cab__info">
            <view class="cab__line">
              <text class="cab__name">{{item.name}}</text>
              <text wx:if="{{item.hitCount}}" class="cab__hit">{{item.hitCount}} 命中</text>
              <text class="cab__count num">{{item.count}}</text>
            </view>
            <view class="cab__foot">
              <view class="cab__preview">
                <text class="cab__emoji" wx:for="{{item.preview}}" wx:for-item="pe" wx:key="k">{{pe.e}}</text>
              </view>
              <text wx:if="{{item.empty}}" class="cab__empty">空着</text>
              <text wx:elif="{{item.expired > 0}}" class="cab__flag is-danger">{{item.expired}} 过期</text>
              <text wx:elif="{{item.warning > 0}}" class="cab__flag is-warning">{{item.warning}} 临期</text>
            </view>
          </view>
        </view>

        <!-- 整理态才能新建：平时不占地方 -->
        <view wx:if="{{organizing}}" class="wall-new" bindtap="onAddContainer">
          <text class="wall-new__plus">＋</text>
          <text class="wall-new__text">新建容器</text>
        </view>
      </view>

      <!-- 在途记录入口 -->
      <view class="pending-add">
        <block wx:if="{{!showPendingAdd}}">
          <text class="pending-add__link" bindtap="onTogglePendingAdd">＋ 买了还没到？先记一条</text>
        </block>
        <block wx:else>
          <input
            class="ui-input pending-add__input"
            placeholder="买了什么，比如 三箱牛奶"
            placeholder-class="ui-placeholder"
            value="{{pendingName}}"
            bindinput="onPendingName"
            confirm-type="done"
            bindconfirm="onSavePending"
            focus="{{showPendingAdd}}" />
          <view class="pending-add__row">
            <text class="pending-add__cancel" bindtap="onTogglePendingAdd">取消</text>
            <button class="ui-btn is-primary pending-add__ok" bindtap="onSavePending">记下</button>
          </view>
        </block>
      </view>

      <!-- 搜不到 / 真的一件都没有，是两件事，别用同一句话糊过去 -->
      <view class="wall-empty" wx:if="{{!wall.length && keyword}}">
        <text class="wall-empty__text">没找到「{{keyword}}」</text>
        <text class="wall-empty__desc">换个词试试，或者清空看看全部</text>
        <button class="ui-btn is-block wall-empty__btn" bindtap="onClearSearch">清空搜索</button>
      </view>

      <view class="wall-empty" wx:elif="{{!wall.length}}">
        <text class="wall-empty__text">收纳里还是空的</text>
        <text class="wall-empty__desc">记一件东西时写上「放冰箱」，它就会出现在这里</text>
        <button class="ui-btn is-primary is-block wall-empty__btn" bindtap="onGoQuick">记一件</button>
      </view>
    </block>

    <!-- ==================== 容器内部 ==================== -->
    <block wx:else>
      <view class="inside-bar">
        <text class="inside-bar__desc">{{active.desc}}</text>
        <view class="inside-bar__flags">
          <text wx:if="{{active.expired > 0}}" class="ui-badge is-expired">已过期 {{active.expired}}</text>
          <text wx:if="{{active.warning > 0}}" class="ui-badge is-warning">临期 {{active.warning}}</text>
          <text wx:if="{{!active.expired && !active.warning}}" class="ui-badge is-fresh">都还新鲜</text>
          <text wx:if="{{active.rows > 0}}" class="ui-badge">{{active.rows}} 层</text>
        </view>
      </view>

      <!-- 内胆：冰箱冷光、木柜暖色，隔板一层层往上垒 -->
      <view class="cavity cavity--{{active.skin}}">
        <view wx:if="{{active.skin === 'fridge'}}" class="cavity__lamp"></view>

        <view
          class="zone {{dragOver === zone.dropKey ? 'is-drop' : ''}}"
          data-zone="{{zone.key}}"
          wx:for="{{active.zones}}" wx:for-item="zone" wx:key="key">
          <view wx:if="{{zone.name}}" class="zone__bar">
            <text class="zone__name">{{zone.name}}</text>
            <text class="zone__count num">{{zone.count}} 件</text>
            <text wx:if="{{zone.expired > 0}}" class="zone__flag is-danger">{{zone.expired}} 过期</text>
            <text wx:elif="{{zone.warning > 0}}" class="zone__flag is-warning">{{zone.warning}} 临期</text>
            <text
              class="zone__add"
              data-container="{{active.id}}"
              data-zone="{{zone.key}}"
              catchtap="onAddHere">＋</text>
          </view>

          <view
            class="shelf {{!shelf.items.length ? 'is-blank' : ''}} {{dragOver === shelf.dropKey ? 'is-drop' : ''}}"
            data-zone="{{zone.key}}"
            data-row="{{shelf.no}}"
            wx:for="{{zone.shelves}}" wx:for-item="shelf" wx:key="k">
            <view class="shelf__tier shelf__tier--{{active.cols}}">
              <view
                wx:for="{{shelf.items}}" wx:for-item="t" wx:key="id"
                id="t{{t.id}}"
                class="thing {{t.cls}} {{t.hit ? 'is-hit' : ''}} {{t.dim ? 'is-dim' : ''}} {{dragOver === t.id ? 'is-target' : ''}} {{drag && drag.id === t.id ? 'is-lifted' : ''}}"
                data-id="{{t.id}}"
                data-zone="{{zone.key}}"
                data-row="{{t.row}}"
                data-name="{{t.name}}"
                data-emoji="{{t.emoji}}"
                bindlongpress="onTileLongPress"
                bindtouchmove="onDragMove"
                bindtouchend="onDragEnd"
                bindtap="onTapTile"
                hover-class="thing--pressed"
                hover-stay-time="60">
                <!-- 角标和状态点贴在图案上，不能贴着格子边，否则会飘在半空 -->
                <view class="thing__pic">
                  <image wx:if="{{t.imageSrc}}" class="thing__img" src="{{t.imageSrc}}" mode="aspectFill" />
                  <text wx:else class="thing__emoji">{{t.emoji}}</text>
                  <text wx:if="{{t.qtyText}}" class="thing__qty num">{{t.qtyText}}</text>
                  <view wx:if="{{t.dot}}" class="thing__dot {{t.cls}}"></view>
                </view>
                <text class="thing__name">{{t.name}}</text>
              </view>
            </view>
            <view class="shelf__board"></view>
          </view>
        </view>

        <view class="cavity__floor"></view>
      </view>

      <view class="inside-hint">
        <text class="inside-hint__text">点一样东西看详情；长按可以拖着换位置。图案左上角的小点：橙色快到期、红色已过期。</text>
      </view>

      <!-- 直接放进这个柜子：预填 location，保存后回到这里看到新块 -->
      <button
        class="ui-btn is-primary is-block inside-add"
        data-container="{{active.id}}"
        data-zone=""
        bindtap="onAddHere">＋ 记一件放这里</button>
    </block>
    </block>

    <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- 拖拽时浮出的「换柜子」条：柜内看不见别的柜子，靠它把东西拖出去 -->
  <view wx:if="{{drag && xferTargets.length}}" class="xfer">
    <text class="xfer__hint">松手放到别的柜子</text>
    <scroll-view class="xfer__list" scroll-x enable-flex>
      <view
        wx:for="{{xferTargets}}" wx:key="id"
        class="xfer__cab {{dragOver === item.dropKey ? 'is-drop' : ''}}"
        data-id="{{item.id}}">
        <text class="xfer__icon">{{item.icon}}</text>
        <text class="xfer__name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 拖拽跟随块：手指移到哪，影子跟到哪 -->
  <view wx:if="{{drag}}" class="ghost" style="left:{{drag.x}}px;top:{{drag.y}}px">
    <text class="ghost__emoji">{{drag.emoji}}</text>
  </view>
  <view wx:if="{{pdrag}}" class="ghost ghost--pending" style="left:{{pdrag.x}}px;top:{{pdrag.y}}px">
    <text class="ghost__emoji">{{pdrag.emoji}}</text>
    <text class="ghost__name">{{pdrag.name}}</text>
  </view>

  <!-- ==================== 容器编辑面板 ==================== -->
  <view wx:if="{{editor}}" class="sheet-mask" bindtap="onCloseEditor">
    <view class="sheet" catchtap="noop">
      <view class="sheet__head">
        <text class="sheet__title">{{editor.mode === 'create' ? '新建容器' : '编辑容器'}}</text>
        <text class="sheet__close" catchtap="onCloseEditor">关闭</text>
      </view>

      <scroll-view class="sheet__body" scroll-y>
        <view class="field">
          <text class="field__label">叫什么</text>
          <input
            class="ui-input"
            value="{{editor.name}}"
            placeholder="比如 阳台收纳箱"
            placeholder-class="ui-placeholder"
            maxlength="12"
            bindinput="onEditorName" />
        </view>

        <view class="field">
          <text class="field__label">图标</text>
          <view class="chip-row">
            <text
              wx:for="{{icons}}" wx:key="*this"
              class="chip chip--icon {{editor.icon === item ? 'is-on' : ''}}"
              data-icon="{{item}}"
              catchtap="onPickIcon">{{item}}</text>
          </view>
        </view>

        <view class="field">
          <text class="field__label">画成什么样</text>
          <view class="chip-row">
            <text
              wx:for="{{skins}}" wx:key="key"
              class="chip {{editor.skin === item.key ? 'is-on' : ''}}"
              data-skin="{{item.key}}"
              catchtap="onPickSkin">{{item.label}}</text>
          </view>
        </view>

        <view class="field field--split">
          <view class="step-block">
            <text class="field__label">每层放几件</text>
            <view class="step">
              <text class="step__btn" data-field="cols" data-delta="-1" catchtap="onStep">−</text>
              <text class="step__num num">{{editor.cols}}</text>
              <text class="step__btn" data-field="cols" data-delta="1" catchtap="onStep">＋</text>
            </view>
          </view>
          <view class="step-block">
            <text class="field__label">几层（0 = 自动）</text>
            <view class="step">
              <text class="step__btn" data-field="rows" data-delta="-1" catchtap="onStep">−</text>
              <text class="step__num num">{{editor.rows}}</text>
              <text class="step__btn" data-field="rows" data-delta="1" catchtap="onStep">＋</text>
            </view>
          </view>
        </view>

        <view class="field">
          <text class="field__label">归位关键字</text>
          <input
            class="ui-input"
            value="{{editor.keysText}}"
            placeholder="位置里会出现的词，顿号隔开"
            placeholder-class="ui-placeholder"
            maxlength="60"
            bindinput="onEditorKeys" />
          <text class="field__hint">记东西时位置里出现这些词，就归到这个柜子。比如「储物柜、收纳箱」。</text>
        </view>
      </scroll-view>

      <view class="sheet__foot">
        <button
          wx:if="{{editor.deletable}}"
          class="ui-btn sheet__del"
          catchtap="onDeleteContainer">删除</button>
        <button class="ui-btn is-primary sheet__ok" catchtap="onSaveEditor">保存</button>
      </view>
    </view>
  </view>

  <!-- ==================== 物品快捷面板（S-11） ==================== -->
  <view wx:if="{{itemEditor}}" class="sheet-mask" bindtap="onCloseItemEditor">
    <view class="sheet" catchtap="noop">
      <view class="sheet__head sheet__head--item">
        <view class="item-head">
          <view class="item-head__pic">
            <image wx:if="{{itemEditor.imageSrc}}" class="item-head__img" src="{{itemEditor.imageSrc}}" mode="aspectFill" />
            <text wx:else class="item-head__emoji">{{itemEditor.emoji}}</text>
          </view>
          <view class="item-head__text">
            <text class="item-head__name">{{itemEditor.name}}</text>
            <text class="item-head__where">{{itemEditor.location}}</text>
          </view>
        </view>
        <text class="sheet__close" catchtap="onGoItemDetail">看详情 ›</text>
      </view>

      <view class="sheet__body">
        <view class="field">
          <text class="field__label">还有多少（{{itemEditor.unit}}）</text>
          <view class="step">
            <text class="step__btn" data-delta="-1" catchtap="onItemQtyStep">−</text>
            <input
              class="step__num item-qty__input"
              type="digit"
              value="{{itemEditor.quantityText}}"
              bindinput="onItemQtyInput"
              bindblur="onItemQtyBlur" />
            <text class="step__btn" data-delta="1" catchtap="onItemQtyStep">＋</text>
          </view>
          <text class="field__hint">改完自动保存，不用点确定。减到 0 也不会自动删掉。</text>
        </view>
      </view>

      <view class="sheet__foot">
        <button class="ui-btn sheet__del" catchtap="onItemUsedUp">用完了</button>
        <button class="ui-btn is-primary sheet__ok" catchtap="onGoItemEdit">编辑全部字段</button>
      </view>
    </view>
  </view>
  <!-- 多选态底部条：攒够了一次放完，不用一件件拖 -->
  <view wx:if="{{pendingSelect}}" class="pending-bar">
    <text class="pending-bar__count">已选 {{pendingCheckedCount}} 件</text>
    <view class="pending-bar__actions">
      <text class="pending-bar__cancel" bindtap="onCancelPendingSelect">取消</text>
      <view class="pending-bar__ok {{pendingCheckedCount ? '' : 'is-off'}}" bindtap="onPlaceChecked">放进柜子</view>
    </view>
  </view>

  <!-- 拖拽时藏起来：底部会浮出「换柜子」条，两个都贴底会挤在一起 -->
  <feedback-fab hidden="{{!!drag}}" spacer="{{false}}" />
</view>
