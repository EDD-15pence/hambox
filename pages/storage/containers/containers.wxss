/* ============================================================
 * 智能仓储 · 容器墙 / 容器内部
 * 只写本页差异；颜色、阴影、间距全部来自 styles/*
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------- 概览 ---------- */
.summary {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.summary__num {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  color: var(--text-1);
}

.summary__label {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.summary__flag {
  margin-left: auto;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-tiny);
  font-weight: 600;
}

.summary__flag.is-danger {
  color: var(--danger);
  background: var(--danger-weak);
}

.summary__flag.is-warning {
  color: var(--warning);
  background: var(--warning-weak);
}

/* ---------- 容器墙 ---------- */
.wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.wall-card {
  display: flex;
  flex-direction: column;
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

.wall-card--pressed {
  box-shadow: var(--shadow-raised-press);
}

.wall-card__head {
  display: flex;
  align-items: center;
}

.wall-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: var(--sp-1);
  border-radius: var(--r-sm);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  font-size: 30rpx;
  line-height: 1;
}

.wall-card__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
}

.wall-card__desc {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  line-height: 1.4;
  color: var(--text-3);
}

.wall-card__foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: var(--sp-2);
}

.wall-card__count {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-2);
}

.wall-empty {
  padding: 120rpx 0;
  text-align: center;
}

.wall-empty__text {
  font-size: var(--fs-body);
  color: var(--text-3);
}

/* ---------- 容器内部 ---------- */
.inside-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-1) 0 var(--sp-2);
}

.inside-head__desc {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.inside-head__flags {
  display: flex;
  gap: 8rpx;
}

/* 块：网格自动排布，统一尺寸 —— 整齐比花哨重要，格子也不会因为数量变化而错位 */
.grid {
  display: grid;
  gap: var(--sp-2);
}

.grid--3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid--4 {
  grid-template-columns: repeat(4, 1fr);
}

.tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--r-md);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

.grid--3 .tile {
  height: 200rpx;
}

.grid--4 .tile {
  height: 168rpx;
}

/* 描边走 inset：不占布局，加不加都不会让格子错位 */
.tile.is-warning {
  box-shadow: inset 0 0 0 3rpx var(--warning), var(--shadow-raised);
}

.tile.is-expired {
  box-shadow: inset 0 0 0 3rpx var(--danger), var(--shadow-raised);
}

.tile--pressed {
  box-shadow: var(--shadow-raised-press);
}

.tile__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.tile__initial {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--text-2);
  opacity: 0.85;
}

/* 名称贴底，用一条渐变盖住图片下沿，避免白字压白图看不清 */
.tile__name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 8rpx 8rpx;
  font-size: var(--fs-tiny);
  line-height: 1.3;
  text-align: center;
  color: var(--text-2);
  background: linear-gradient(transparent, var(--bg-raised) 55%);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile__qty {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: var(--r-pill);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  font-size: var(--fs-tiny);
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  color: var(--text-2);
}

.inside-hint {
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.inside-hint__text {
  font-size: var(--fs-tiny);
  line-height: 1.5;
  color: var(--text-3);
}

/* ---------- 骨架 ---------- */
.wall-skeleton {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.wall-skeleton__card {
  height: 200rpx;
  border-radius: var(--r-lg);
}

.bottom-spacer {
  height: calc(var(--sp-6) + env(safe-area-inset-bottom));
}
