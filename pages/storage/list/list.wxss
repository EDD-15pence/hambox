/* ============================================================
 * 智能仓储 · 列表页（轻新拟物 v2）
 * 只写本页差异；材质、尺寸、颜色全部来自 styles/*
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

/* scroll-view 只负责滚动，不带任何横向 padding：
   它在部分机型上会把 padding 算到 100% 之外，导致内容右移、右侧被裁。
   页面边距一律交给内部 .page-body。 */
.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------- 顶部统计：三个凹陷槽 ---------- */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-3) var(--sp-1);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  transition: box-shadow var(--dur-fast) ease-out;
}

/* 选中 = 按得更深 + 标签转主色（只靠阴影区分不够明显） */
.stat.is-on {
  box-shadow: var(--shadow-raised-press);
}

.stat.is-on .stat__label {
  color: var(--primary);
  font-weight: 600;
}

.stat__num {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.stat__num.is-danger {
  color: var(--danger);
}

.stat__num.is-warning {
  color: var(--warning);
}

.stat__label {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* ---------- 一句话记录入口：可点击 → 凸起 ---------- */
.quick-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

.is-pressed,
.quick-entry:active {
  box-shadow: var(--shadow-raised-press);
}

.quick-entry__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quick-entry__title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-1);
}

.quick-entry__desc {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-entry__arrow {
  flex: none;
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-3);
}

/* ---------- 搜索 ---------- */
.search-wrap {
  position: relative;
  margin-top: var(--sp-2);
}

.search-input {
  padding-right: 110rpx;
}

.search-clear {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: var(--hit);
  padding: 0 var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--text-3);
}

/* ---------- 分类胶囊 ---------- */
.chips {
  margin-top: var(--sp-2);
  white-space: nowrap;
}

.chips__inner {
  display: flex;
  gap: var(--sp-1);
  padding: 4rpx 0 12rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-pill);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

/* 选中 = 按下去（凹陷），这是新拟物里最自然的选中语义 */
.chip.is-on {
  box-shadow: var(--shadow-sunken-sm);
}

.chip__icon {
  font-size: var(--fs-caption);
  line-height: 1;
}

.chip__name {
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.chip.is-on .chip__name {
  color: var(--primary);
  font-weight: 600;
}

.chip__count {
  font-size: var(--fs-tiny);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.chip.is-on .chip__count {
  color: var(--primary);
}

/* ---------- 列表头 ---------- */
.list-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: var(--sp-2) 4rpx var(--sp-2);
}

.list-bar__count {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.list-bar__filter {
  color: var(--primary);
  font-weight: 600;
}

.sort {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  flex: none;
}

.sort__opt {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.sort__opt.is-on {
  color: var(--text-1);
  font-weight: 600;
}

/* ---------- 物品行：可点击 → 凸起 ---------- */
.items {
  display: flex;
  flex-direction: column;
}

.item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

.item + .item {
  margin-top: var(--sp-2);
}

.item--pressed {
  box-shadow: var(--shadow-raised-press);
}

/* 缩略图是"槽"：凸起卡片里的凹槽 */
.item__thumb {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--bg-sunken);
}

.item__thumb--slot {
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sunken-sm);
}

.item__image {
  width: 100%;
  height: 100%;
  display: block;
}

.item__emoji {
  font-size: 40rpx;
  line-height: 1;
}

.item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-1);
}

.item__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item__meta {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item__qty {
  flex: none;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.item__arrow {
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-3);
  opacity: 0.7;
}

.bottom-spacer {
  height: 200rpx;
}

/* ---------- FAB：加号用两条线画，不用字符 ---------- */
.fab-plus {
  position: relative;
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--on-primary);
}

.fab-plus::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: -18rpx;
  width: 4rpx;
  height: 40rpx;
  border-radius: 2rpx;
  background: var(--on-primary);
}

/* ---------- 弹层内部 ---------- */
.sheet-close {
  font-size: var(--fs-caption);
  color: var(--text-3);
  padding: var(--sp-1);
}

.sheet-body {
  padding: var(--sp-4) 0 var(--sp-3);
}

.sheet-message {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text-2);
}

.sheet-actions {
  display: flex;
  gap: var(--sp-2);
  padding-bottom: var(--sp-2);
}

.sheet-scroll {
  max-height: 60vh;
}

/* ---------- 分类管理 ---------- */
.cat-list {
  display: flex;
  flex-direction: column;
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.cat-item + .cat-item {
  margin-top: var(--sp-1);
}

.cat-item--readonly {
  box-shadow: none;
  background: transparent;
  opacity: 0.75;
}

.cat-item__name {
  font-size: var(--fs-body);
  color: var(--text-1);
}

.cat-item__hint {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* 删除是文字按钮，不用垃圾桶 emoji */
.cat-item__action {
  font-size: var(--fs-caption);
  color: var(--danger);
  padding: var(--sp-1) var(--sp-2);
}

.cat-empty {
  padding: var(--sp-4);
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.cat-add {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-3);
}

.cat-add__name {
  flex: 1;
  min-width: 0;
}

.cat-add__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--hit);
  height: var(--hit);
  border-radius: var(--r-md);
  font-size: 40rpx;
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.cat-add__btn {
  flex: none;
  height: var(--hit);
  padding: 0 var(--sp-3);
}
