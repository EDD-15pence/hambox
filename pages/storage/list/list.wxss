/* ============================================================
 * 智能仓储 · 列表页（轻新拟物 v2）
 * 只写本页差异；材质、尺寸、颜色全部来自 styles/*
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  /* 改成 page 滚动才能触发下拉刷新（B-03）：高度由内容决定，不再锁死 100vh */
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

/* 自绘导航在 page 滚动下必须粘住，否则滑两屏就找不到返回键 */
.app-nav {
  position: sticky;
  top: 0;
  z-index: 20;
}

/* 页面边距一律交给内部 .page-body，这里只负责横向占满。
   B-03 之后不再是 scroll-view：高度由内容撑开，页面整体滚动（下拉刷新才生效） */
.page-scroll {
  width: 100%;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------- 顶部统计：三个凹陷槽 ---------- */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
  margin-top: var(--sp-1);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-3) var(--sp-1);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  transition: box-shadow var(--dur-fast) ease-out;
}

/* 选中 = 按得更深 + 标签转主色（只靠阴影区分不够明显） */
.stat.is-on {
  box-shadow: var(--shadow-raised-press);
}

.stat.is-on .stat__label {
  color: var(--primary);
  font-weight: 600;
}

.stat__num {
  font-size: var(--fs-h1);
  font-weight: 600;
  line-height: 1.1;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.stat__num.is-danger {
  color: var(--danger);
}

.stat__num.is-warning {
  color: var(--warning);
}

.stat__label {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* ---------- 一句话记录入口：可点击 → 凸起 ---------- */
.quick-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

.is-pressed,
.quick-entry:active {
  box-shadow: var(--shadow-raised-press);
}

.quick-entry__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quick-entry__title {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-1);
}

.quick-entry__desc {
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-entry__arrow {
  flex: none;
  font-size: 36rpx;
  line-height: 1;
  color: var(--text-3);
}

/* ---------- 搜索 ---------- */
/* ---------- 分类胶囊 ---------- */
.chips {
  margin-top: var(--sp-2);
  white-space: nowrap;
}

.chips__inner {
  display: flex;
  gap: var(--sp-1);
  padding: 4rpx 0 12rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-pill);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

/* 选中 = 按下去（凹陷），这是新拟物里最自然的选中语义 */
.chip.is-on {
  box-shadow: var(--shadow-sunken-sm);
}

.chip__icon {
  font-size: var(--fs-caption);
  line-height: 1;
}

.chip__name {
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.chip.is-on .chip__name {
  color: var(--primary);
  font-weight: 600;
}

.chip__count {
  font-size: var(--fs-tiny);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.chip.is-on .chip__count {
  color: var(--primary);
}

/* ---------- 列表头 ---------- */
.list-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: var(--sp-2) 4rpx var(--sp-2);
}

.list-bar__count {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.list-bar__filter {
  color: var(--primary);
  font-weight: 600;
}

.sort {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  flex: none;
}

.sort__opt {
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.sort__opt.is-on {
  color: var(--text-1);
  font-weight: 600;
}

/* ---------- 物品行：可点击 → 凸起 ---------- */
.items {
  display: flex;
  flex-direction: column;
}

.item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

.item + .item {
  margin-top: var(--sp-2);
}

.item--pressed {
  box-shadow: var(--shadow-raised-press);
}

/* 缩略图是"槽"：凸起卡片里的凹槽 */
.item__thumb {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--bg-sunken);
}

.item__thumb--slot {
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sunken-sm);
}

.item__image {
  width: 100%;
  height: 100%;
  display: block;
}

.item__emoji {
  font-size: 40rpx;
  line-height: 1;
}

.item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-1);
}

.item__name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item__meta {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 数量就地加减：按钮视觉小、热区够，连点不容易点偏 */
.qty {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.qty__btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--r-sm);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 52rpx;
  text-align: center;
  color: var(--text-2);
  background: var(--bg-page);
  box-shadow: var(--shadow-raised);
}

.qty__btn:active {
  box-shadow: var(--shadow-raised-press);
}

.qty__val {
  min-width: 62rpx;
  font-size: var(--fs-tiny);
  text-align: center;
  color: var(--text-3);
}

.qty__val.is-empty {
  opacity: 0.75;
}

/* 用完了的行退到背景里，但还留在列表里，方便再点 + 恢复 */
.item.is-empty {
  opacity: 0.62;
}

.item.is-empty .item__name {
  color: var(--text-3);
}


.bottom-spacer {
  height: 200rpx;
}

/* ---------- FAB：加号用两条线画，不用字符 ---------- */
.fab-plus {
  position: relative;
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--on-primary);
}

.fab-plus::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: -18rpx;
  width: 4rpx;
  height: 40rpx;
  border-radius: 2rpx;
  background: var(--on-primary);
}

/* ---------- 弹层内部 ---------- */
.sheet-close {
  font-size: var(--fs-caption);
  color: var(--text-3);
  padding: var(--sp-1);
}

.sheet-body {
  padding: var(--sp-4) 0 var(--sp-3);
}

.sheet-message {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text-2);
}

.sheet-actions {
  display: flex;
  gap: var(--sp-2);
  padding-bottom: var(--sp-2);
}

.sheet-scroll {
  max-height: 60vh;
}

/* ---------- 分类管理 ---------- */
.cat-list {
  display: flex;
  flex-direction: column;
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.cat-item + .cat-item {
  margin-top: var(--sp-1);
}

.cat-item--readonly {
  box-shadow: none;
  background: transparent;
  opacity: 0.75;
}

.cat-item__name {
  font-size: var(--fs-body);
  color: var(--text-1);
}

.cat-item__hint {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* 删除是文字按钮，不用垃圾桶 emoji */
.cat-item__action {
  font-size: var(--fs-caption);
  color: var(--danger);
  padding: var(--sp-1) var(--sp-2);
}

.cat-empty {
  padding: var(--sp-4);
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.cat-add {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-3);
}

.cat-add__name {
  flex: 1;
  min-width: 0;
}

.cat-add__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--hit);
  height: var(--hit);
  border-radius: var(--r-md);
  font-size: 40rpx;
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.cat-add__btn {
  flex: none;
  height: var(--hit);
  padding: 0 var(--sp-3);
}

/* ============================================================
 * 首屏骨架 / 刷新失败提示
 * ============================================================ */
.skeleton {
  padding-top: var(--sp-1);
}

.skeleton__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-2);
}

.skeleton__stat {
  height: 132rpx;
  border-radius: var(--r-md);
}

.skeleton__entry {
  height: 128rpx;
  margin-top: var(--sp-3);
  border-radius: var(--r-md);
}

.skeleton__row {
  display: flex;
  align-items: center;
  margin-top: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.skeleton__thumb {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-sm);
}

.skeleton__lines {
  flex: 1;
  min-width: 0;
  margin-left: var(--sp-2);
}

.skeleton__line {
  height: 28rpx;
  width: 52%;
  border-radius: var(--r-sm);
}

.skeleton__line.is-short {
  width: 30%;
  margin-top: var(--sp-2);
}
