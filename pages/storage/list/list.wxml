<view class="container {{isDark ? 'dark' : ''}}">
  <!-- 自绘导航：app.json 已设 navigationStyle custom -->
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">智能仓储</text>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn {{showSearch ? 'is-on' : ''}}" bindtap="onToggleSearch">搜索</text>
      <text class="nav-text-btn" bindtap="onOpenCategoryModal">分类</text>
      <text class="nav-text-btn" bindtap="onToggleTheme">{{isDark ? '日间' : '夜间'}}</text>
    </view>
  </view>

  <!-- 容器 / 清单：同一份数据的两种看法，切换不堆页面栈 -->
  <view class="ui-segment-wrap">
    <view class="ui-segment">
      <text class="ui-segment__item" data-mode="containers" bindtap="onSwitchMode">容器</text>
      <text class="ui-segment__item is-on" data-mode="list" bindtap="onSwitchMode">清单</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body">
    <!-- 首屏加载：骨架屏占位，避免空列表闪一下「还没有物品」 -->
    <block wx:if="{{loading && items.length === 0}}">
      <view class="skeleton">
        <view class="skeleton__stats">
          <view class="skeleton__stat ui-skeleton"></view>
          <view class="skeleton__stat ui-skeleton"></view>
          <view class="skeleton__stat ui-skeleton"></view>
        </view>
        <view class="skeleton__entry ui-skeleton"></view>
        <view class="skeleton__row" wx:for="{{[1,2,3,4]}}" wx:key="*this">
          <view class="skeleton__thumb ui-skeleton"></view>
          <view class="skeleton__lines">
            <view class="skeleton__line ui-skeleton"></view>
            <view class="skeleton__line is-short ui-skeleton"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- 连不上后端：一张能照着排查的卡片，而不是弹一下就消失的 toast -->
    <conn-error
      wx:elif="{{loadError && items.length === 0}}"
      message="{{loadError}}"
      base-url="{{baseUrl}}"
      retrying="{{retrying}}"
      bind:retry="onRetry" />

    <block wx:else>
    <!-- 已经有数据但这次没刷新成功：保留旧列表，只提示一次 -->
    <view wx:if="{{loadError}}" class="ui-notice" bindtap="onRetry">
      <text class="ui-notice__text">这次没刷新成功 · {{loadError}}</text>
      <text class="ui-notice__action">重试</text>
    </view>

    <!-- 顶部统计：三个凹陷槽，点一下按状态筛选 -->
    <view class="stats">
      <view
        class="stat {{statusFilter === 'expired' ? 'is-on' : ''}}"
        bindtap="onSelectStatus" data-status="expired">
        <text class="stat__num {{stats.expired > 0 ? 'is-danger' : ''}}">{{stats.expired}}</text>
        <text class="stat__label">已过期</text>
      </view>
      <view
        class="stat {{statusFilter === 'warning' ? 'is-on' : ''}}"
        bindtap="onSelectStatus" data-status="warning">
        <text class="stat__num {{stats.warning > 0 ? 'is-warning' : ''}}">{{stats.warning}}</text>
        <text class="stat__label">临期</text>
      </view>
      <view
        class="stat {{statusFilter === 'fresh' ? 'is-on' : ''}}"
        bindtap="onSelectStatus" data-status="fresh">
        <text class="stat__num">{{stats.fresh + stats.none}}</text>
        <text class="stat__label">正常</text>
      </view>
    </view>

    <!-- 一句话快速记录入口：可点击，所以是凸起的 -->
    <view class="quick-entry is-pressable" bindtap="onQuickAdd" hover-class="is-pressed">
      <view class="quick-entry__text">
        <text class="quick-entry__title">点一下说话，快速记录</text>
        <text class="quick-entry__desc">也可以直接打字，例：可乐 保质期9个月 放厨房柜子</text>
      </view>
      <text class="quick-entry__arrow">›</text>
    </view>

    <!-- 搜索框：展开时出现，凹陷 -->
    <view wx:if="{{showSearch}}" class="ui-search">
      <input class="ui-input ui-search__input"
        placeholder="搜名称 / 位置 / 备注"
        placeholder-class="ui-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
        focus="{{showSearch}}" />
      <text wx:if="{{keyword}}" class="ui-search__clear" bindtap="onClearSearch">清空</text>
    </view>

    <!-- 分类：胶囊，选中态按下去（凹陷） -->
    <scroll-view class="chips" scroll-x enable-flex>
      <view class="chips__inner">
        <view
          wx:for="{{categories}}" wx:key="id" wx:for-item="cat"
          class="chip {{selectedCategory === cat.id ? 'is-on' : ''}}"
          bindtap="onSelectCategory" data-id="{{cat.id}}">
          <text class="chip__icon">{{cat.icon}}</text>
          <text class="chip__name">{{cat.name}}</text>
          <text class="chip__count">{{cat.count}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 列表头：结果数 + 排序 -->
    <view class="list-bar">
      <text class="list-bar__count">
        <text wx:if="{{statusFilter !== 'all'}}" class="list-bar__filter" bindtap="onClearStatus">
          {{statusFilter === 'expired' ? '已过期' : (statusFilter === 'warning' ? '临期' : '正常')}} ·
        </text>
        {{displayItems.length}} 件
      </text>
      <view class="sort">
        <text class="sort__opt {{sortBy === 'expiry' ? 'is-on' : ''}}" bindtap="onToggleSort" data-sort="expiry">过期优先</text>
        <text class="sort__opt {{sortBy === 'created' ? 'is-on' : ''}}" bindtap="onToggleSort" data-sort="created">最近添加</text>
      </view>
    </view>

    <!-- 物品列表：可点击，所以每行凸起 -->
    <view class="items">
      <view
        wx:for="{{displayItems}}" wx:key="id"
        class="item {{item.quantity === 0 ? 'is-empty' : ''}}"
        bindtap="onTapItem" data-id="{{item.id}}"
        bindlongpress="onLongPressItem" data-id="{{item.id}}" data-name="{{item.name}}"
        hover-class="item--pressed" hover-stay-time="60">

        <view wx:if="{{item.imageSrc}}" class="item__thumb">
          <image class="item__image" src="{{item.imageSrc}}" mode="aspectFill" />
        </view>
        <view wx:else class="item__thumb item__thumb--slot">
          <text class="item__emoji">{{categoryMap[item.category] ? categoryMap[item.category].icon : '📦'}}</text>
        </view>

        <view class="item__body">
          <view class="item__row">
            <text class="item__name">{{item.name}}</text>
            <text wx:if="{{item.status === 'expired'}}" class="ui-badge is-expired">过期{{-item.daysLeft}}天</text>
            <text wx:elif="{{item.status === 'warning'}}" class="ui-badge is-warning">剩{{item.daysLeft}}天</text>
            <text wx:elif="{{item.status === 'fresh'}}" class="ui-badge is-fresh">剩{{item.daysLeft}}天</text>
          </view>
          <view class="item__row">
            <text class="item__meta">
              <text wx:if="{{categoryMap[item.category]}}">{{categoryMap[item.category].name}}</text>
              <text wx:else>其他</text>
              <text wx:if="{{item.location}}"> · {{item.location}}</text>
            </text>
            <!-- 数量就地加减：吃掉了、买多了不用点进详情 -->
            <view class="qty" catchtap="stopPropagation">
              <text
                class="qty__btn"
                data-id="{{item.id}}"
                data-delta="-1"
                catchtap="onQtyChange">−</text>
              <text wx:if="{{item.quantity > 0}}" class="qty__val num">{{item.quantity}}{{item.unit}}</text>
              <text wx:else class="qty__val is-empty">用完了</text>
              <text
                class="qty__btn"
                data-id="{{item.id}}"
                data-delta="1"
                catchtap="onQtyChange">＋</text>
            </view>
          </view>
        </view>

      </view>

      <!-- 空状态 -->
      <view wx:if="{{displayItems.length === 0}}" class="ui-empty">
        <text class="ui-empty__icon">{{keyword ? '🔍' : '📦'}}</text>
        <text class="ui-empty__title">
          {{keyword ? '没有匹配的物品' : (statusFilter !== 'all' ? '这个状态下没有物品' : (selectedCategory !== 'all' ? '该分类下暂无物品' : '还没有物品'))}}
        </text>
        <text class="ui-empty__hint" wx:if="{{!keyword && selectedCategory === 'all' && statusFilter === 'all'}}">点右下角添加第一个物品，或者用上面的一句话记录</text>
      </view>
    </view>

    <view class="bottom-spacer"></view>
    </block>
    </view>
  </scroll-view>

  <!-- 悬浮添加：加号用两条线画，不用字符图标 -->
  <view class="ui-fab" bindtap="onAddItem">
    <view class="fab-plus"></view>
  </view>

  <!-- 语音记账：抬到添加按钮上方，避免两个悬浮球叠在一起 -->
  <voice-add fab-offset="{{128}}" bind:saved="onVoiceSaved" />

  <!-- 删除确认 -->
  <view wx:if="{{showDeleteModal}}" class="ui-mask" bindtap="onCancelDelete">
    <view class="ui-sheet" catchtap="stopPropagation">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">删除物品</text>
        <text class="sheet-close" bindtap="onCancelDelete">取消</text>
      </view>
      <view class="sheet-body">
        <text class="sheet-message">确定删除「{{deleteTargetName}}」吗？删除后无法恢复。</text>
      </view>
      <view class="sheet-actions">
        <button class="ui-btn is-block is-danger" bindtap="onConfirmDelete">删除</button>
      </view>
    </view>
  </view>

  <!-- 分类管理 -->
  <view wx:if="{{showCategoryModal}}" class="ui-mask" bindtap="onCloseCategoryModal">
    <view class="ui-sheet" catchtap="stopPropagation">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">管理分类</text>
        <text class="sheet-close" bindtap="onCloseCategoryModal">完成</text>
      </view>

      <scroll-view class="sheet-scroll" scroll-y>
        <text class="ui-section-title">预设分类</text>
        <view class="cat-list">
          <view wx:for="{{defaultCategories}}" wx:key="id" class="cat-item cat-item--readonly">
            <text class="cat-item__name">{{item.icon}} {{item.name}}</text>
            <text class="cat-item__hint">预设</text>
          </view>
        </view>

        <text class="ui-section-title">自定义分类</text>
        <view class="cat-list">
          <view wx:for="{{customCategories}}" wx:key="id" class="cat-item">
            <text class="cat-item__name">{{item.icon}} {{item.name}}</text>
            <text class="cat-item__action" bindtap="onDeleteCustomCategory" data-id="{{item.id}}">删除</text>
          </view>
          <view wx:if="{{customCategories.length === 0}}" class="cat-empty">暂无自定义分类</view>
        </view>

        <text class="ui-section-title">新增分类</text>
        <view class="cat-add">
          <input class="ui-input cat-add__name"
            placeholder="分类名称"
            placeholder-class="ui-placeholder"
            value="{{newCategoryName}}"
            bindinput="onNewCategoryNameInput"
            maxlength="10" />
          <picker mode="selector" range="{{iconOptions}}" bindchange="onNewCategoryIconChange">
            <view class="cat-add__icon">{{newCategoryIcon}}</view>
          </picker>
          <button class="ui-btn cat-add__btn" bindtap="onAddCustomCategory">添加</button>
        </view>
      </scroll-view>
    </view>
  </view>
  <feedback-fab side="left" />
</view>
