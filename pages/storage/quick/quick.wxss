/* ============================== */
/* 智能仓储 - 快速记录页样式       */
/* ============================== */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f6f7fb;
  color: #000000;
  padding-bottom: 40rpx;
}

/* ---------- 导航栏 ---------- */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}
.navbar-title {
  font-size: 36rpx;
  font-weight: bold;
}
.navbar-actions {
  display: flex;
  gap: 8rpx;
}
.icon-btn {
  background: transparent;
  border: none;
  padding: 8rpx 12rpx;
  font-size: 32rpx;
  line-height: 1;
}
.icon-btn::after {
  border: none;
}
.icon-hover {
  opacity: 0.6;
}

/* ---------- 输入提示 ---------- */
.hint-row {
  padding: 16rpx 32rpx 0;
}
.hint-text {
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 1.5;
}

/* ---------- 一句话输入 ---------- */
.input-card {
  margin: 16rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.quick-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #000000;
}
.quick-placeholder {
  color: #b0b4bb;
}
.input-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.counter {
  font-size: 22rpx;
  color: #b0b4bb;
}
.btn-parse {
  margin: 0;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: #007aff;
  border-radius: 32rpx;
}
.btn-parse::after {
  border: none;
}
.btn-parse.disabled {
  background: #c8d6e5;
}

/* ---------- 识别结果 ---------- */
.preview-card {
  margin: 8rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.preview-title {
  font-size: 30rpx;
  font-weight: 600;
}
.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: #b0b4bb;
}
.status-fresh {
  background: #34c759;
}
.status-warning {
  background: #ff9500;
}
.status-expired {
  background: #ff3b30;
}
.status-none {
  background: #c7cbd1;
}

/* ---------- 字段行 ---------- */
.field-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}
.field-row:last-of-type {
  border-bottom: none;
}
.field-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #8a8f99;
}
.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
  height: 56rpx;
  line-height: 56rpx;
}
.field-picker {
  font-size: 28rpx;
  color: #000000;
  padding: 8rpx 0;
}
.field-picker.empty {
  color: #b0b4bb;
}
.qty-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.qty-input {
  width: 120rpx;
  flex: none;
  text-align: center;
  background: #f5f6f8;
  border-radius: 10rpx;
}
.unit-picker {
  padding: 8rpx 20rpx;
  background: #f5f6f8;
  border-radius: 10rpx;
}
.shelf-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.shelf-input {
  flex: none;
  width: 100rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f5f6f8;
  border-radius: 10rpx;
}
.shelf-unit {
  font-size: 24rpx;
  color: #8a8f99;
}
.shelf-or {
  font-size: 22rpx;
  color: #c7cbd1;
  margin: 0 8rpx;
}

/* ---------- 缺项提示 ---------- */
.missing-hint {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #fff8e6;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: #b26a00;
  line-height: 1.6;
}
.missing-item {
  font-weight: 600;
}

/* ---------- 按钮 ---------- */
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.btn-primary {
  flex: 1;
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 29rpx;
  color: #ffffff;
  background: #007aff;
  border-radius: 14rpx;
}
.btn-primary::after {
  border: none;
}
.btn-secondary {
  flex: 1;
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 29rpx;
  color: #007aff;
  background: #eef5ff;
  border-radius: 14rpx;
}
.btn-secondary::after {
  border: none;
}
.btn-ghost {
  flex: 1;
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  color: #8a8f99;
  background: #f5f6f8;
  border-radius: 14rpx;
}
.btn-ghost::after {
  border: none;
}

/* ---------- 空态示例 ---------- */
.tips-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.tips-title {
  font-size: 26rpx;
  color: #8a8f99;
}
.tips-line {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
}

.saved-hint {
  text-align: center;
  font-size: 24rpx;
  color: #34c759;
  padding: 16rpx;
}

/* ---------- 深色 ---------- */
.dark {
  background: #111111;
  color: #ffffff;
}
.dark .navbar {
  background: #1c1c1e;
  border-bottom-color: #2a2a2c;
}
.dark .input-card,
.dark .preview-card,
.dark .tips-card {
  background: #1c1c1e;
  box-shadow: none;
}
.dark .quick-input,
.dark .field-input,
.dark .field-picker {
  color: #ffffff;
}
.dark .preview-header,
.dark .field-row {
  border-bottom-color: #2a2a2c;
}
.dark .qty-input,
.dark .shelf-input,
.dark .unit-picker {
  background: #2a2a2c;
}
.dark .btn-secondary {
  background: #16263a;
}
.dark .btn-ghost {
  background: #2a2a2c;
}
.dark .tips-line {
  color: #d0d0d0;
}
.dark .missing-hint {
  background: #3a2f14;
  color: #ffcc80;
}
