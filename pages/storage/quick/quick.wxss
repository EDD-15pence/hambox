/* ============================================================
 * 智能仓储 · 快速记录页（轻新拟物 v2）
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

/* scroll-view 只负责滚动，不带任何横向 padding：
   它在部分机型上会把 padding 算到 100% 之外，导致内容右移、右侧被裁。
   页面边距一律交给内部 .page-body。 */
.page-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x);
}

/* ---------- 输入卡：凸起容器，内部输入区是凹槽 ---------- */
.input-card {
  margin-top: var(--sp-1);
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.input-card__area {
  min-height: 200rpx;
}

/* ---------- 语音输入：待机凹槽，录音时槽内加深 + 红点呼吸 ---------- */
.voice-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  height: var(--hit);
  margin-top: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  /* 88rpx 的小槽必须用小号阴影，大号会把边缘糊掉（§5.2） */
  box-shadow: var(--shadow-sunken-sm);
  transition: box-shadow var(--dur-fast) ease-out, background var(--dur-fast) ease-out;
}

/* 录音中：凹槽"被按下"，底色转主色浅底，读者一眼知道正在录 */
.voice-bar.is-recording {
  background: var(--primary-weak);
  box-shadow: var(--shadow-raised-press);
}

.voice-bar.is-off {
  opacity: 0.55;
}

/* 待机时不显示圆点（保留占位，避免文字左右跳），录音中才亮起 */
.voice-bar__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--danger);
  opacity: 0;
  transition: opacity var(--dur-fast) ease-out;
}

.voice-bar.is-recording .voice-bar__dot {
  opacity: 1;
  animation: voice-blink 1s ease-in-out infinite;
}

.voice-bar__text {
  font-size: var(--fs-caption);
  color: var(--text-2);
}

.voice-bar.is-recording .voice-bar__text {
  color: var(--primary);
  font-weight: 600;
}

@keyframes voice-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.28; }
}

.input-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.input-card__hint {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 词库纠错过用词时换成主色，和普通提示区分开 */
.input-card__hint.is-fix {
  color: var(--primary-strong);
}

.input-card__counter {
  flex: none;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.input-card__btn {
  margin-top: var(--sp-2);
}

/* ---------- 解析结果 ---------- */
.result {
  margin-top: var(--sp-2);
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.result__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.result__title {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text-1);
}

.result__actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

/* ---------- 字段（与编辑页同一套） ---------- */
.field {
  margin-bottom: var(--sp-2);
}

.field__label {
  display: block;
  margin: 0 4rpx 10rpx;
  font-size: var(--fs-tiny);
  font-weight: 500;
  color: var(--text-3);
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: var(--hit);
  padding: 0 var(--sp-3);
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken);
}

.picker__text {
  font-size: var(--fs-body);
  color: var(--text-1);
}

.picker__placeholder {
  font-size: var(--fs-body);
  color: var(--text-3);
}

.picker__arrow {
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-3);
}

.qty-row {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.qty-row__input {
  flex: 1;
  min-width: 0;
}

.qty-row__unit {
  width: 180rpx;
}

.shelf {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.shelf__input {
  width: 140rpx;
  flex: none;
  text-align: center;
}

.shelf__unit {
  flex: none;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.shelf__or {
  flex: none;
  margin: 0 var(--sp-1);
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* ---------- 缺失提示 ---------- */
.missing {
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  background: var(--warning-weak);
}

.missing__text {
  font-size: var(--fs-tiny);
  line-height: 1.6;
  color: var(--warning);
}

.missing__item {
  font-weight: 600;
}

/* ---------- 示例 ---------- */
.tips {
  margin-top: var(--sp-2);
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.tips__title {
  display: block;
  margin-bottom: var(--sp-1);
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-2);
}

.tips__line {
  display: block;
  padding: 6rpx 0;
  font-size: var(--fs-tiny);
  line-height: 1.5;
  color: var(--text-3);
}

/* ---------- 连续记录提示 ---------- */
.saved {
  margin-top: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--success-weak);
  text-align: center;
}

.saved__text {
  display: block;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--success);
}

.saved__hint {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.bottom-spacer {
  height: calc(var(--sp-6) + env(safe-area-inset-bottom));
}

/* ---------- 名称必填 / 解析兜底 ---------- */
.field__required {
  margin-left: var(--sp-1);
  font-size: var(--fs-tiny);
  font-weight: 400;
  color: var(--danger);
}

/* 名称空着时给输入框一圈警示描边，光靠文字提示不够醒目 */
.ui-input.is-alert {
  box-shadow: var(--shadow-sunken-sm), 0 0 0 2rpx var(--danger);
}

.fallback {
  margin-bottom: var(--sp-3);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--warning-weak);
}

.fallback__title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--warning);
}

.fallback__desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  line-height: 1.6;
  color: var(--text-2);
}

.fallback__label {
  display: block;
  margin-top: var(--sp-3);
  margin-bottom: var(--sp-1);
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.fallback__examples {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fallback__eg {
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  font-size: var(--fs-tiny);
  line-height: 1.5;
  color: var(--text-2);
}

.fallback__eg:active {
  box-shadow: var(--shadow-raised-press);
}
