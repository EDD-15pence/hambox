<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">快速记录</text>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onGoList">物品列表</text>
      <text class="nav-text-btn" bindtap="onToggleTheme">{{isDark ? '日间' : '夜间'}}</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body">
    <!-- 输入卡：凸起 -->
    <view class="input-card">
      <textarea
        class="ui-textarea input-card__area"
        value="{{raw}}"
        placeholder="例：可乐 生产日期9月1日 保质期9个月 放厨房柜子"
        placeholder-class="ui-placeholder"
        maxlength="200"
        auto-height
        focus="{{inputFocus}}"
        confirm-type="done"
        confirm-hold="true"
        cursor-spacing="40"
        bindinput="onRawInput"
        bindconfirm="onParseTap" />

      <!-- 语音输入：点一下开始，再说一句结束 → 自动解析 -->
      <view
        class="voice-bar {{recording ? 'is-recording' : ''}} {{voiceAvailable ? '' : 'is-off'}}"
        bindtap="onVoiceTap">
        <view class="voice-bar__dot"></view>
        <text class="voice-bar__text">{{recording ? '点一下结束' : (voiceAvailable ? '点一下说话' : '语音未启用')}}</text>
      </view>

      <view class="input-card__foot">
        <text class="input-card__hint {{fixNote ? 'is-fix' : ''}}">{{recording ? '正在听…' : (fixNote || '说一句，自动拆成名称、数量、位置')}}</text>
        <text class="input-card__counter num">{{raw.length}}/200</text>
      </view>
      <button class="ui-btn is-block is-primary input-card__btn" bindtap="onParseTap" disabled="{{!raw}}">解析这句话</button>
    </view>

    <!-- 从柜子里点「＋」进来：先说明会放到哪儿，免得记完找不到东西 -->
    <view wx:if="{{presetLocation}}" class="preset-tip">
      <text class="preset-tip__text">放到 · {{presetLocation}}</text>
      <text class="preset-tip__hint">说了别的位置，就以你说的为准</text>
    </view>

    <view wx:if="{{savedCount > 0}}" class="saved">
      <text class="saved__text">今天已记 {{savedCount}} 条</text>
      <text class="saved__hint">{{presetLocation ? '记完自动回到柜子' : '接着记下一条就行，不用返回'}}</text>
    </view>

    <!-- 解析结果 -->
    <view wx:if="{{parsed}}" class="result">
      <!-- 兜底：整句里没认出名称时，别让用户对着空框发呆 -->
      <view wx:if="{{needName}}" class="fallback">
        <text class="fallback__title">这次没抓出是哪件东西</text>
        <text class="fallback__desc">名称是必填的，直接在下面名称框里填；分类、数量、位置也都能手动改，不影响保存。</text>
        <text class="fallback__label">照着这样说更准</text>
        <view class="fallback__examples">
          <text
            wx:for="{{examples}}" wx:key="*this"
            class="fallback__eg"
            data-text="{{item}}"
            bindtap="onUseExample">{{item}}</text>
        </view>
      </view>

      <view class="result__head">
        <text class="result__title">识别结果</text>
        <text wx:if="{{statusText}}" class="ui-badge is-{{daysLeft === null ? 'primary' : (daysLeft > 30 ? 'fresh' : (daysLeft > 0 ? 'warning' : 'expired'))}}">{{statusText}}</text>
        <text wx:else class="ui-badge">未设过期日</text>
      </view>

      <view class="field">
        <text class="field__label">名称 <text wx:if="{{needName}}" class="field__required">必填</text></text>
        <input class="ui-input {{needName ? 'is-alert' : ''}}" value="{{draft.name}}" data-field="name" bindinput="onFieldInput" placeholder="物品名称，如 可乐" placeholder-class="ui-placeholder" focus="{{focusName}}" />
      </view>

      <view class="field">
        <text class="field__label">分类</text>
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="picker">
            <text class="picker__text">{{categoryNames[categoryIndex] || '其他'}}</text>
            <text class="picker__arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field__label">数量</text>
        <view class="qty-row">
          <input class="ui-input qty-row__input" type="digit" value="{{draft.quantity}}" data-field="quantity" bindinput="onFieldInput" />
          <picker mode="selector" range="{{presetUnits}}" value="{{unitIndex}}" bindchange="onUnitChange">
            <view class="picker qty-row__unit">
              <text class="picker__text">{{draft.unit}}</text>
              <text class="picker__arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="field">
        <text class="field__label">生产日期</text>
        <picker mode="date" value="{{draft.produceDate}}" start="2000-01-01" end="2100-12-31" bindchange="onProduceDateChange">
          <view class="picker">
            <text class="{{draft.produceDate ? 'picker__text' : 'picker__placeholder'}}">{{draft.produceDate || '未填'}}</text>
            <text class="picker__arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field__label">保质期</text>
        <view class="shelf">
          <input class="ui-input shelf__input" type="number" value="{{draft.shelfLifeMonths}}" placeholder="月" placeholder-class="ui-placeholder" data-field="shelfLifeMonths" bindinput="onShelfMonthsInput" />
          <text class="shelf__unit">月</text>
          <text class="shelf__or">或</text>
          <input class="ui-input shelf__input" type="number" value="{{draft.shelfLifeDays}}" placeholder="天" placeholder-class="ui-placeholder" data-field="shelfLifeDays" bindinput="onShelfDaysInput" />
          <text class="shelf__unit">天</text>
        </view>
      </view>

      <view class="field">
        <text class="field__label">过期日</text>
        <picker mode="date" value="{{draft.expireDate}}" start="2000-01-01" end="2100-12-31" bindchange="onExpireDateChange">
          <view class="picker">
            <text class="{{draft.expireDate ? 'picker__text' : 'picker__placeholder'}}">{{draft.expireDate || '未填'}}</text>
            <text class="picker__arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field__label">存放位置</text>
        <input class="ui-input" value="{{draft.location}}" data-field="location" bindinput="onFieldInput" placeholder="如 冰箱冷藏 / 厨房柜子" placeholder-class="ui-placeholder" />
      </view>

      <view wx:if="{{missing.length > 0}}" class="missing">
        <text class="missing__text">
          没识别到
          <text wx:for="{{missing}}" wx:key="*this" class="missing__item">{{item === 'produceDate' ? '生产日期' : (item === 'shelfLife' ? '保质期' : '存放位置')}}{{index === missing.length - 1 ? '' : '、'}}</text>
          ，可以直接在上面补
        </text>
      </view>

      <view class="result__actions">
        <button class="ui-btn is-block is-primary" bindtap="onSave" disabled="{{saving}}">保存并继续记</button>
        <button class="ui-btn is-block" bindtap="onSaveAndDetail" disabled="{{saving}}">保存并看详情</button>
        <button class="ui-btn is-block is-ghost" bindtap="onOpenForm">用完整表单填</button>
      </view>
    </view>

    <!-- 空态示例 -->
    <view wx:if="{{!parsed && !raw}}" class="tips">
      <text class="tips__title">这样说就行</text>
      <text class="tips__line" wx:for="{{examples}}" wx:key="*this">{{item}}</text>
    </view>


    <view class="bottom-spacer"></view>
    </view>
  </scroll-view>
  <feedback-fab spacer="{{false}}" />
</view>
