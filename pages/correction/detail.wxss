/* ============================================================
 * 随机打卡 · 详情（§19 / H-07）
 *
 * 这一页是「看结果」，不是「做事情」：所有数字都由后端算好，
 * 这里只负责排布。颜色语义固定：正在 = warning，没有 = success，跳过 = 灰。
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

.app-nav {
  position: sticky;
  top: 0;
  z-index: 20;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: 0 var(--page-x) calc(var(--sp-6) + env(safe-area-inset-bottom));
}

/* ---------------- 今天四格 ---------------- */

.today {
  display: flex;
  margin-top: var(--sp-2);
  padding: var(--sp-3) var(--sp-2);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.today__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.today__item + .today__item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--divider);
}

.today__label {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.today__value {
  font-size: var(--fs-h1);
  font-weight: 700;
  line-height: 1.1;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}

.today__value.is-warn {
  color: var(--warning);
}

.today__value.is-ok {
  color: var(--success);
}

.today__value.is-mute {
  color: var(--text-3);
}

.today__unit {
  font-size: var(--fs-tiny);
  font-weight: 400;
  color: var(--text-3);
}

.ask-now {
  display: block;
  margin-top: var(--sp-2);
  text-align: right;
  font-size: var(--fs-caption);
  color: var(--primary-text);
}

/* ---------------- 无犯率 ---------------- */

.rate {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  margin-top: var(--sp-3);
  padding: var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.rate__left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
  min-width: 180rpx;
}

.rate__label {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.rate__value {
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1.2;
  color: var(--success);
  font-variant-numeric: tabular-nums;
}

.rate__right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rate__line {
  font-size: var(--fs-caption);
  color: var(--text-2);
  line-height: 1.5;
}

/* ---------------- 通用卡片 ---------------- */

.card {
  margin-top: var(--sp-3);
  padding: var(--sp-4);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card__title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
}

.card__more {
  font-size: var(--fs-caption);
  color: var(--primary-text);
}

.card__hint {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-tiny);
  color: var(--text-3);
  line-height: 1.6;
}

/* ---------------- 七天圆点 ---------------- */

.day {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.day__label {
  flex: none;
  width: 76rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.day__dots {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}

.day__none {
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.day__count {
  flex: none;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--bg-sunken);
}

.dot.is-ok {
  background: var(--success);
}

.dot.is-warn {
  background: var(--warning);
}

.dot.is-mute {
  background: var(--text-3);
}

.dot.is-idle {
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.legend {
  display: flex;
  gap: var(--sp-3);
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: 1rpx solid var(--divider);
}

.legend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* ---------------- 时段分布 ---------------- */

.hour {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.hour__label {
  flex: none;
  width: 90rpx;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.hour__bar {
  flex: 1;
  height: 20rpx;
  border-radius: var(--r-pill);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  overflow: hidden;
}

.hour__fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--warning);
}

.hour__count {
  flex: none;
  width: 48rpx;
  text-align: right;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* ---------------- 建议库 ---------------- */

.sg {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--divider);
}

.sg__text {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--text-2);
  line-height: 1.6;
}

.sg__tag {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-tiny);
  color: var(--text-3);
  background: var(--bg-sunken);
}

.sg__del {
  flex: none;
  padding: 0 6rpx;
  font-size: var(--fs-caption);
  color: var(--danger);
}

.sg-add {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.sg-add__input {
  flex: 1;
}

.sg-add__btn {
  flex: none;
  width: 120rpx;
}

/* ---------------- 底部动作 ---------------- */

.actions {
  margin-top: var(--sp-4);
}

.actions__hint {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-tiny);
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}

.retry {
  width: 100%;
  margin-top: var(--sp-3);
}
