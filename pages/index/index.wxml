<view class="container {{isDark ? 'dark' : ''}}">
  <!-- 自绘导航栏：app.json 已关闭系统导航（navigationStyle: custom） -->
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="app-nav__titles">
      <text class="app-nav__title">汉堡盒</text>
      <text class="app-nav__sub">{{todayText}} · {{tools.length}} 个工具</text>
    </view>
    <view class="app-nav__actions">
      <button class="icon-btn" hover-class="icon-hover" bindtap="onToggleTheme" bindlongpress="onResetTheme">{{isDark ? '🌙' : '☀️'}}</button>
    </view>
  </view>

  <view class="content">
    <view class="grid">
      <view
        class="tool-card"
        wx:for="{{tools}}"
        wx:key="key"
        data-tool="{{item.key}}"
        bindtap="navigateToTool"
        hover-class="tool-card--active"
        hover-stay-time="80">
        <!-- 智能仓储有临期/过期时在卡片右上角顶一个数字 -->
        <view
          wx:if="{{item.key === 'storage' && storageBadge > 0}}"
          class="tool-badge is-{{storageBadgeType}}">{{storageBadge}}</view>
        <view class="tool-icon">
          <text class="tool-icon__emoji">{{item.icon}}</text>
        </view>
        <view class="tool-head">
          <text class="tool-name">{{item.name}}</text>
          <text wx:if="{{item.tag}}" class="ui-badge">{{item.tag}}</text>
        </view>
        <text class="tool-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- 一张卡都没有 = 身份是访客、或 ACL 里一个工具都没有。给出口，别给白屏 -->
    <view wx:if="{{tools.length === 0}}" class="empty-auth">
      <text class="empty-auth__icon">🔒</text>
      <text class="empty-auth__title">这个身份还没有可用的工具</text>
      <text class="empty-auth__desc">后台可能刚授权、或这台设备的身份还没登记。先点「重新登录」换一张新会话；还不行就把 openid 发给管理员。</text>
      <button class="ui-btn is-primary empty-auth__btn" bindtap="onRefreshIdentity">重新登录</button>
      <text class="empty-auth__link" bindtap="onOpenSettings">查看身份信息 ›</text>
    </view>

    <view class="footer">
      <text class="footer-text">点卡片进入 · 右下角说话直接记一笔</text>
      <!-- 隐藏入口：长按版本号进连接设置（换网段 / 换令牌用，见 utils/env.js 覆盖层） -->
      <text class="footer-ver" bindlongpress="onOpenSettings">v{{versionText}}</text>
    </view>
  </view>

  <!-- 悬浮麦克风：说一句 → 面板内确认 → 直接入库，不跳页面 -->
  <voice-add bind:saved="onVoiceSaved" />
  <!-- 随机打卡的 A 线：打开小程序就弹一次（同一条本次会话只弹一次） -->
  <correction-ask id="ask" />
  <feedback-fab side="left" spacer="{{false}}" />
</view>
