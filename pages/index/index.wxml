<view class="container {{isDark ? 'dark' : ''}}">
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <text class="navbar-title">工具箱</text>
    <view class="navbar-actions">
      <button class="icon-btn" hover-class="icon-hover" bindtap="onToggleTheme">{{isDark ? '🌙' : '☀️'}}</button>
    </view>
  </view>

  <!-- 工具网格 -->
  <view class="tools-grid">
    <!-- 亲属称呼换算器卡片 -->
    <view class="tool-card" bindtap="navigateToTool" data-tool="relationship">
      <view class="tool-icon">👨‍👩‍👧‍👦</view>
      <text class="tool-name">亲属称呼换算</text>
      <text class="tool-desc">快速计算亲属关系称呼</text>
    </view>


    <!-- 打卡工具卡片 -->
    <view class="tool-card" bindtap="navigateToTool" data-tool="punchin">
      <view class="tool-icon">📅</view>
      <text class="tool-name">打卡</text>
      <text class="tool-desc">记录你的打卡时间</text>
    </view>

    <!-- 智能仓储工具卡片 -->
    <view class="tool-card" bindtap="navigateToTool" data-tool="storage">
      <view class="tool-icon">📦</view>
      <text class="tool-name">智能仓储</text>
      <text class="tool-desc">管理物品保质期与库存</text>
    </view>

    <!-- 快速记录卡片 -->
    <view class="tool-card" bindtap="navigateToTool" data-tool="quick">
      <view class="tool-icon">🎙️</view>
      <text class="tool-name">快速记录</text>
      <text class="tool-desc">一句话记下买的东西和保质期</text>
    </view>

    <!-- Prompt模板工具卡片 -->
    <view class="tool-card" bindtap="navigateToTool" data-tool="flight">
      <view class="tool-icon">✈️</view>
      <text class="tool-name">机票比价</text>
      <text class="tool-desc">一键对比多个平台的机票价格</text>
    </view>

    <view class="tool-card" bindtap="navigateToTool" data-tool="prompt">
      <view class="tool-icon">📝</view>
      <text class="tool-name">Prompt模板工具</text>
      <text class="tool-desc">一键生成高质量AI提示词</text>
    </view>

    <!-- 未来可以添加更多工具卡片 -->
    <!-- 
    <view class="tool-card" bindtap="navigateToTool" data-tool="other">
      <view class="tool-icon">🎯</view>
      <text class="tool-name">其他工具</text>
      <text class="tool-desc">敬请期待</text>
    </view>
    -->
  </view>

  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">点击卡片打开对应工具</text>
  </view>
</view>

