/* 首页 —— 只写本页差异，颜色/间距/圆角/阴影全部取自设计令牌 */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-page);
  color: var(--text-1);
}

.content {
  flex: 1;
  /* 底部留出悬浮麦克风的位置，最后一排卡片不会被压住 */
  padding: var(--sp-2) var(--page-x) 140rpx;
}

/* ---------- 工具网格 ---------- */
/* 卡片间距 20rpx 略小于阴影模糊半径，但只用到 28rpx 的柔和外投影，
   所以边缘不会互相污染（硬性下限见 AGENTS.md §5.4） */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
}

/* 凸起卡片：与页面同色，只有影子说明它存在 */
.tool-card {
  display: flex;
  flex-direction: column;
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  transition: box-shadow var(--dur-fast) ease-out;
}

/* 按下 = 把这对影子翻成 inset，元素不位移 */
.tool-card--active {
  box-shadow: var(--shadow-raised-press);
}

/* 图标槽：卡片是凸的，槽是凹的，一凸一凹才有材质 */
.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.tool-icon__emoji {
  font-size: 40rpx;
  line-height: 1;
}

.tool-head {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-top: var(--sp-2);
}

.tool-name {
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tool-desc {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  line-height: 1.4;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 底部说明 ---------- */
.footer {
  padding: var(--sp-6) 0 calc(var(--sp-4) + env(safe-area-inset-bottom));
  text-align: center;
}

.footer-text {
  display: block;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.footer-text--sub {
  margin-top: 6rpx;
  opacity: 0.8;
}
