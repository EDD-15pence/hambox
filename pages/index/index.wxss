/* 首页 —— 只写本页差异，颜色/间距/圆角/阴影全部取自设计令牌 */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-page);
  color: var(--text-1);
}

.content {
  flex: 1;
  /* 底部留出悬浮麦克风的位置，最后一排卡片不会被压住 */
  padding: var(--sp-2) var(--page-x) 140rpx;
}

/* ---------- 工具网格 ---------- */
/* 间距 24rpx，比单张卡的投影模糊半径略大：卡片并排时影子不会在缝里连成脏灰。
   （原来 16rpx + 32rpx 模糊，正是 A-12「日间阴影奇怪」的来源） */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-3);
}

/* 凸起卡片：与页面同色，只有影子说明它存在。
   网格专用影子（--shadow-card-grid）把白高光从 alpha=1 收到 .68、
   模糊从 32rpx 收到 18rpx，左上不再像描了道白边 */
.tool-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-card-grid);
  transition: box-shadow var(--dur-fast) ease-out;
}

/* 临期角标：贴在卡片右上角，压住圆角一点才有"挂上去"的感觉 */
.tool-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: var(--r-pill);
  font-size: var(--fs-tiny);
  font-weight: 600;
  line-height: 40rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  color: var(--text-invert);
  background: var(--warning);
  box-shadow: 0 4rpx 12rpx rgba(138, 82, 0, 0.28);
}

.tool-badge.is-danger {
  background: var(--danger);
  box-shadow: 0 4rpx 12rpx rgba(180, 35, 24, 0.28);
}

/* 按下 = 把这对影子翻成 inset，元素不位移 */
.tool-card--active {
  box-shadow: var(--shadow-raised-press);
}

/* 图标槽：卡片是凸的，槽是凹的，一凸一凹才有材质 */
.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.tool-icon__emoji {
  font-size: 40rpx;
  line-height: 1;
}

.tool-head {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-top: var(--sp-2);
}

.tool-name {
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tool-desc {
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  line-height: 1.4;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 底部说明 ---------- */
.footer {
  padding: var(--sp-6) 0 calc(var(--sp-4) + env(safe-area-inset-bottom));
  text-align: center;
}

/* ---------- 空状态：身份没给到任何工具 ---------- */
/* 宁可多一块说明，也不要让人对着一片空白猜是不是坏了 */
.empty-auth {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-4) var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-card);
}

.empty-auth__icon {
  font-size: 56rpx;
  line-height: 1;
}

.empty-auth__title {
  margin-top: var(--sp-2);
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--text-1);
}

.empty-auth__desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--text-3);
  line-height: 1.6;
  text-align: center;
}

.empty-auth__btn {
  margin-top: var(--sp-3);
  width: 100%;
}

.empty-auth__link {
  margin-top: var(--sp-2);
  padding: 8rpx 16rpx;
  font-size: var(--fs-caption);
  color: var(--primary-text);
}

.footer-text {
  display: block;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

/* 版本号兼隐藏入口：不做按钮外观，但仍要留够可长按的高度 */
.footer-ver {
  display: inline-block;
  margin-top: var(--sp-1);
  padding: 8rpx 16rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
  opacity: 0.65;
}
