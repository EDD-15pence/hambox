/* ============================================================
 * 记录 · 当天详情（R-02）
 * ============================================================ */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}

.app-nav {
  position: sticky;
  top: 0;
  z-index: 20;
}

.page-body {
  box-sizing: border-box;
  width: 100%;
  padding: var(--sp-2) var(--page-x) 0;
}

/* ---------------- 一句话录入 ---------------- */

.composer {
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
}

.composer__input {
  width: 100%;
  min-height: 88rpx;
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--text-1);
}

.composer__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.composer__hint {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.composer__ok {
  flex: none;
  min-width: 140rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 var(--sp-3);
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
}

/* ---------------- 作品 / 物品入口 ---------------- */

.composer-types {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.composer-types__btn {
  padding: 10rpx var(--sp-3);
  border-radius: var(--r-pill);
  background: var(--bg-raised);
  box-shadow: var(--shadow-raised);
  font-size: var(--fs-tiny);
  color: var(--text-2);
}

.composer-types__btn:active {
  box-shadow: var(--shadow-raised-press);
}

/* ---------------- 条目 ---------------- */

.entry {
  margin-top: var(--sp-2);
}

.entry.has-image {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
}

.entry__body {
  flex: 1;
  min-width: 0;
}

.entry__thumb {
  flex: none;
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--r-sm);
  background: var(--bg-sunken);
}

.entry__title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.entry__tag {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--primary-weak);
  color: var(--primary);
  font-size: var(--fs-tiny);
}

.entry__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: var(--sp-1);
}

.entry__kv {
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  background: var(--bg-sunken);
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.entry__kv--more {
  background: transparent;
}

.entry__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
}

.entry__title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-1);
  word-break: break-word;
}

.entry__clock {
  flex: none;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.entry__comment {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-caption);
  line-height: 1.55;
  color: var(--text-2);
  word-break: break-word;
}

.entry__content {
  display: block;
  margin-top: var(--sp-1);
  padding-top: var(--sp-1);
  border-top: 1rpx solid var(--divider);
  font-size: var(--fs-caption);
  line-height: 1.6;
  color: var(--text-3);
  word-break: break-word;
}

.day-retry {
  margin-top: var(--sp-3);
}

/* ---------------- 编辑面板 ---------------- */

.day-sheet {
  max-height: 82vh;
}

.day-sheet__label {
  display: block;
  margin: var(--sp-2) 0 6rpx;
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.day-sheet__area {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
}

.day-sheet__foot {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.day-sheet__del {
  flex: 0 0 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
  color: var(--danger);
  background: var(--danger-weak);
}

.day-sheet__ok {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
}

/* ---------------- 主图与字段行（作品 / 物品） ---------------- */

.img-field {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.img-field__thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}

.img-field__add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-md);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
  font-size: var(--fs-tiny);
  color: var(--text-3);
}

.img-field__clear {
  font-size: var(--fs-tiny);
  color: var(--danger);
}

.kv-row {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: var(--sp-1);
}

.kv-row__k {
  flex: 0 0 200rpx;
}

.kv-row__v {
  flex: 1;
  min-width: 0;
}

.kv-row__del {
  flex: none;
  width: 56rpx;
  text-align: center;
  font-size: var(--fs-h2);
  color: var(--text-3);
}

.kv-add {
  display: inline-block;
  padding: 10rpx 0;
  font-size: var(--fs-tiny);
  color: var(--primary);
}

.day-sheet__cancel {
  flex: 0 0 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-md);
  color: var(--text-2);
  background: var(--bg-sunken);
}

.day-sheet__hint {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-tiny);
  line-height: 1.6;
  color: var(--text-3);
}

.day-sheet__to-answer {
  display: block;
  margin-top: var(--sp-3);
  padding: var(--sp-2) 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--primary);
  border-top: 1rpx solid var(--divider);
}
