<view class="container {{isDark ? 'dark' : ''}}">
  <view class="app-nav" style="padding-top:{{statusBarHeight}}px;padding-right:{{navRight}}px">
    <view class="nav-left">
      <text class="nav-back-icon" bindtap="onBack">‹</text>
      <text class="app-nav__title">{{dateLabel || '记录'}}</text>
    </view>
    <view class="app-nav__actions">
      <text class="nav-text-btn" bindtap="onRetry">刷新</text>
    </view>
  </view>

  <view class="page-body">
    <!-- 一句话录入：写完点「记下」，括号里的自动变评价 -->
    <view class="composer">
      <textarea
        class="composer__input"
        value="{{draft}}"
        placeholder="记录今天做了什么"
        placeholder-class="ui-placeholder"
        auto-height
        maxlength="500"
        cursor-spacing="24"
        focus="{{focusDraft}}"
        bindinput="onDraftInput" />
      <view class="composer__foot">
        <text class="composer__hint">括号里那句算评价，可以不写</text>
        <button
          class="ui-btn is-primary composer__ok"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="onSaveDraft">记下</button>
      </view>
    </view>

    <!-- 作品 / 物品：要带图和字段，走表单 -->
    <view class="composer-types">
      <text class="composer-types__btn" data-type="work" bindtap="onOpenCreate">+ 作品</text>
      <text class="composer-types__btn" data-type="item" bindtap="onOpenCreate">+ 物品</text>
    </view>

    <view wx:if="{{error}}" class="ui-empty">
      <text class="ui-empty__title">没拉到这一天的记录</text>
      <text class="ui-empty__hint">{{error}}</text>
      <button class="ui-btn is-block day-retry" bindtap="onRetry">重试</button>
    </view>

    <block wx:if="{{!error}}">
      <view wx:if="{{!loading && !items.length}}" class="ui-empty">
        <text class="ui-empty__title">这天还空着</text>
        <text class="ui-empty__hint">上面写一行就记下了</text>
      </view>

      <view
        wx:for="{{items}}"
        wx:key="id"
        class="ui-card entry {{item.imageSrc ? 'has-image' : ''}}"
        data-id="{{item.id}}"
        bindtap="onOpenItem">
        <view class="entry__body">
          <view class="entry__head">
            <view class="entry__title-wrap">
              <text wx:if="{{item.typeLabel}}" class="entry__tag">{{item.typeLabel}}</text>
              <text class="entry__title">{{item.title}}</text>
            </view>
            <text class="entry__clock num">{{item.clock}}</text>
          </view>
          <text wx:if="{{item.comment}}" class="entry__comment">{{item.comment}}</text>
          <view wx:if="{{item.metaChips.length}}" class="entry__meta">
            <text
              wx:for="{{item.metaChips}}"
              wx:for-item="kv"
              wx:key="k"
              class="entry__kv">{{kv.k}} {{kv.v}}</text>
            <text wx:if="{{item.metaMore}}" class="entry__kv entry__kv--more">+{{item.metaMore}}</text>
          </view>
          <text wx:if="{{item.content}}" class="entry__content">{{item.content}}</text>
        </view>
        <image
          wx:if="{{item.imageSrc}}"
          class="entry__thumb"
          src="{{item.imageSrc}}"
          mode="aspectFill"
          lazy-load />
      </view>
    </block>
  </view>

  <!-- 新建作品 / 物品 -->
  <view wx:if="{{creating}}" class="ui-mask" style="padding-bottom: {{kb}}px" bindtap="onCloseCreate">
    <view class="ui-sheet day-sheet" catchtap="onNoop">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">{{creating.type === 'item' ? '记一件物品' : '记一件作品'}}</text>
        <text class="nav-text-btn" bindtap="onCloseCreate">关闭</text>
      </view>

      <text class="day-sheet__label">名字</text>
      <input
        class="ui-input"
        value="{{creating.title}}"
        data-field="title"
        maxlength="200"
        cursor-spacing="24"
        bindinput="onCreateField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <text class="day-sheet__label">主图（可不填）</text>
      <view class="img-field">
        <block wx:if="{{creating.imageSrc}}">
          <image class="img-field__thumb" src="{{creating.imageSrc}}" mode="aspectFill" />
          <text class="img-field__clear" bindtap="onClearCreateImage">删掉</text>
        </block>
        <text wx:else class="img-field__add" bindtap="onCreateImage">{{uploading ? '上传中…' : '+ 加张图'}}</text>
      </view>

      <text class="day-sheet__label">字段（可不填，自己起名）</text>
      <view wx:for="{{creating.metaRows}}" wx:key="id" class="kv-row">
        <input
          class="ui-input kv-row__k"
          value="{{item.k}}"
          placeholder="字段名"
          placeholder-class="ui-placeholder"
          maxlength="16"
          data-index="{{index}}"
          data-part="k"
          cursor-spacing="24"
          bindinput="onCreateMetaInput"
          bindfocus="onKbFocus"
          bindblur="onKbBlur" />
        <input
          class="ui-input kv-row__v"
          value="{{item.v}}"
          placeholder="内容"
          placeholder-class="ui-placeholder"
          maxlength="60"
          data-index="{{index}}"
          data-part="v"
          cursor-spacing="24"
          bindinput="onCreateMetaInput"
          bindfocus="onKbFocus"
          bindblur="onKbBlur" />
        <text class="kv-row__del" data-index="{{index}}" bindtap="onRemoveMetaRow">×</text>
      </view>
      <text class="kv-add" bindtap="onAddMetaRow">+ 加一行</text>

      <text class="day-sheet__label">评价（可不填）</text>
      <input
        class="ui-input"
        value="{{creating.comment}}"
        placeholder="简单评价，可不填"
        placeholder-class="ui-placeholder"
        data-field="comment"
        maxlength="500"
        cursor-spacing="24"
        bindinput="onCreateField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <text class="day-sheet__label">正文（可不填）</text>
      <textarea
        class="ui-input day-sheet__area"
        value="{{creating.content}}"
        placeholder="补充说明，可不填"
        placeholder-class="ui-placeholder"
        data-field="content"
        maxlength="2000"
        cursor-spacing="24"
        bindinput="onCreateField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <view class="day-sheet__foot">
        <button class="ui-btn day-sheet__cancel" bindtap="onCloseCreate">取消</button>
        <button
          class="ui-btn is-primary day-sheet__ok"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="onSaveCreate">记下</button>
      </view>
    </view>
  </view>

  <!-- 编辑面板 -->
  <view wx:if="{{editing}}" class="ui-mask" style="padding-bottom: {{kb}}px" bindtap="onCloseEdit">
    <view class="ui-sheet day-sheet" catchtap="onNoop">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">改这条{{editing.typeLabel ? '（' + editing.typeLabel + '）' : ''}}</text>
        <text class="nav-text-btn" bindtap="onCloseEdit">关闭</text>
      </view>

      <text class="day-sheet__label">标题</text>
      <input
        class="ui-input"
        value="{{editing.title}}"
        data-field="title"
        maxlength="200"
        cursor-spacing="24"
        bindinput="onEditField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <text class="day-sheet__label">主图（可不填）</text>
      <view class="img-field">
        <block wx:if="{{editing.imageSrc}}">
          <image class="img-field__thumb" src="{{editing.imageSrc}}" mode="aspectFill" />
          <text class="img-field__clear" bindtap="onEditClearImage">删掉</text>
        </block>
        <text wx:else class="img-field__add" bindtap="onEditImage">{{uploading ? '上传中…' : '+ 加张图'}}</text>
      </view>

      <text class="day-sheet__label">字段（可不填，自己起名）</text>
      <view wx:for="{{editing.metaRows}}" wx:key="id" class="kv-row">
        <input
          class="ui-input kv-row__k"
          value="{{item.k}}"
          placeholder="字段名"
          placeholder-class="ui-placeholder"
          maxlength="16"
          data-index="{{index}}"
          data-part="k"
          cursor-spacing="24"
          bindinput="onEditMetaInput"
          bindfocus="onKbFocus"
          bindblur="onKbBlur" />
        <input
          class="ui-input kv-row__v"
          value="{{item.v}}"
          placeholder="内容"
          placeholder-class="ui-placeholder"
          maxlength="60"
          data-index="{{index}}"
          data-part="v"
          cursor-spacing="24"
          bindinput="onEditMetaInput"
          bindfocus="onKbFocus"
          bindblur="onKbBlur" />
        <text class="kv-row__del" data-index="{{index}}" bindtap="onEditRemoveMeta">×</text>
      </view>
      <text class="kv-add" bindtap="onEditAddMeta">+ 加一行</text>

      <text class="day-sheet__label">评价</text>
      <input
        class="ui-input"
        value="{{editing.comment}}"
        placeholder="简单评价，可不填"
        placeholder-class="ui-placeholder"
        data-field="comment"
        maxlength="500"
        cursor-spacing="24"
        bindinput="onEditField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <text class="day-sheet__label">正文（可不填）</text>
      <textarea
        class="ui-input day-sheet__area"
        value="{{editing.content}}"
        placeholder="补充说明，可不填"
        placeholder-class="ui-placeholder"
        data-field="content"
        maxlength="2000"
        cursor-spacing="24"
        bindinput="onEditField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <text class="day-sheet__to-answer" bindtap="onOpenAnswer">记为版本答案 ›</text>

      <view class="day-sheet__foot">
        <button class="ui-btn day-sheet__del" bindtap="onDeleteEntry">删掉</button>
        <button
          class="ui-btn is-primary day-sheet__ok"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="onSaveEdit">保存</button>
      </view>
    </view>
  </view>

  <!-- 记为版本答案：关键词 + 答案，预填自这条记录 -->
  <view wx:if="{{answering}}" class="ui-mask" style="padding-bottom: {{kb}}px" bindtap="onCloseAnswer">
    <view class="ui-sheet day-sheet" catchtap="onNoop">
      <view class="ui-sheet__header">
        <text class="ui-sheet__title">记为版本答案</text>
        <text class="nav-text-btn" bindtap="onCloseAnswer">关闭</text>
      </view>
      <text class="day-sheet__hint">以后搜「关键词」就能直接看到答案，同名会覆盖旧的。</text>

      <text class="day-sheet__label">关键词</text>
      <input
        class="ui-input"
        value="{{answering.keyword}}"
        placeholder="关键词"
        placeholder-class="ui-placeholder"
        data-field="keyword"
        maxlength="128"
        cursor-spacing="24"
        bindinput="onAnswerField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <text class="day-sheet__label">答案</text>
      <textarea
        class="ui-input day-sheet__area"
        value="{{answering.answer}}"
        placeholder="具体答案"
        placeholder-class="ui-placeholder"
        data-field="answer"
        maxlength="1000"
        cursor-spacing="24"
        bindinput="onAnswerField"
        bindfocus="onKbFocus"
        bindblur="onKbBlur" />

      <view class="day-sheet__foot">
        <button class="ui-btn day-sheet__cancel" bindtap="onCloseAnswer">取消</button>
        <button
          class="ui-btn is-primary day-sheet__ok"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="onSaveAnswer">存下</button>
      </view>
    </view>
  </view>

  <feedback-fab />
</view>
