/* A-07 令牌迁移：色值改取 styles/tokens.wxss，深色靠 .container.dark 的变量覆盖。
   尺寸单位（px）沿用原值未动。 */
.container {
  padding: 20px;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg-page);
  color: var(--text-1);
}
.header { display: flex; align-items: center; font-size: 20px; font-weight: bold; margin-bottom: 16px; }
.prompt-title { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
.prompt-desc { font-size: 13px; color: var(--text-3); margin-bottom: 16px; }
.var-item { margin-bottom: 12px; }
.var-label { font-size: 13px; color: var(--text-2); margin-bottom: 4px; display: block; }
/* 输入框改用凹陷面表达层级，原来是 1px 浅灰描边，深色下那条边会消失 */
.var-input {
  width: 100%;
  box-sizing: border-box;
  border: none;
  border-radius: var(--r-sm);
  padding: 8px;
  font-size: 14px;
  color: var(--text-1);
  background: var(--bg-sunken);
  box-shadow: var(--shadow-sunken-sm);
}
.copy-btn {
  margin-top: 20px;
  /* 实心填充用 --primary-strong：白字压 --primary 只有 4.02:1 */
  background: var(--primary-strong);
  color: var(--on-primary);
  border-radius: var(--r-sm);
  padding: 10px 0;
  font-size: 15px;
}
.copy-tip { color: var(--text-3); font-size: 12px; margin-top: 8px; }
